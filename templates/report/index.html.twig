{% extends 'base.html.twig' %}

{% block title %}Signaler - Share Trips{% endblock %}

{% block body %}
<div class="report-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5">

                <a href="{{ path('app_profile_booking') }}" class="back-link mb-3 d-inline-flex">
                    <i class="bi bi-arrow-left"></i> Mes réservations
                </a>

                <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:.5rem 0 1.5rem;">
                    Signaler un utilisateur
                </h1>

                <div class="report-card">

                    <div class="d-flex align-items-center gap-3 mb-4 pb-4" style="border-bottom:1.5px solid #f1f5f9;">
                        <div style="width:44px;height:44px;border-radius:50%;background:#1e3a5f;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;">
                            {{ reported.firstName ? reported.firstName|first|upper : '?' }}
                        </div>
                        <div>
                            <div style="font-weight:700;color:#1e3a5f;">{{ reported.firstName ?? '' }} {{ reported.lastName ?? '' }}</div>
                            <div style="font-size:.8rem;color:#94a3b8;">Utilisateur signalé</div>
                        </div>
                    </div>

                    <div class="trip-context mb-4">
                        <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#94a3b8;margin-bottom:.6rem;">
                            Trajet concerné
                        </div>
                        <div style="font-weight:600;color:#1e3a5f;font-size:.875rem;">
                            {{ booking.trip.origin }} → {{ booking.trip.destination }}
                        </div>
                        <div style="font-size:.8rem;color:#94a3b8;margin-top:.2rem;">
                            <i class="bi bi-calendar3 me-1"></i>{{ booking.trip.departureAt|date('d/m/Y à H:i') }}
                        </div>
                    </div>

                    <div class="alert-warning-st">
                        <i class="bi bi-exclamation-triangle-fill" style="flex-shrink:0;"></i>
                        Les signalements abusifs peuvent entraîner la suspension de votre compte.
                    </div>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-3">
                            <label class="report-label"><i class="bi bi-flag me-1"></i>Motif</label>
                            {{ form_widget(form.reason, {'attr': {'class': 'report-input'}}) }}
                            {{ form_errors(form.reason) }}
                        </div>

                        <div class="mb-4">
                            <label class="report-label">
                                Détails <span style="text-transform:none;letter-spacing:0;font-weight:400;color:#cbd5e1;">(optionnel)</span>
                            </label>
                            {{ form_widget(form.details, {'attr': {'class': 'report-input'}}) }}
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn-report">
                                <i class="bi bi-flag-fill"></i> Envoyer le signalement
                            </button>
                            <a href="{{ path('app_profile_booking') }}" class="btn-cancel-link">Annuler</a>
                        </div>

                    {{ form_end(form) }}

                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}