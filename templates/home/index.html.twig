{% extends 'base.html.twig' %}

{% block body %}
    <section class="bg-primary text-white p-5 mb-5"
         style="background: linear-gradient(135deg, #059669, #0284c7) !important;">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <h1 class="display-5 fw-bold mb-3">Voyagez ensemble, dépensez moins.</h1>
                <p class="lead opacity-75">Trouvez ou proposez un covoiturage en quelques clics.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="btn btn-light btn-lg px-4">
                        Trouver un trajet
                    </a>
                    {% if app.user %}
                        <a href="#" class="btn btn-outline-light btn-lg px-4">
                            Proposer un trajet
                        </a>
                    {% else %}
                        <a href="{{ path('app_register') }}" class="btn btn-outline-light btn-lg px-4">
                            S'inscrire
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="col-md-6">
                {# Formulaire de recherche #}
                <div class="bg-white rounded-4 p-4 shadow">
                    <form method="get" action="{{ path('app_home') }}">
                        <div class="mb-3">
                            <label class="form-label text-dark fw-semibold">
                                <i class="bi bi-geo-alt me-1 text-primary"></i>Départ
                            </label>
                            <input type="text" name="origin" class="form-control"
                                   placeholder="Ex : Paris" {#value="{{ origin }}"#}>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-dark fw-semibold">
                                <i class="bi bi-geo me-1 text-primary"></i>Arrivée
                            </label>
                            <input type="text" name="destination" class="form-control"
                                   placeholder="Ex : Lyon" {#value="{{ destination }}"#}>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-dark fw-semibold">
                                <i class="bi bi-calendar me-1 text-primary"></i>Date
                            </label>
                            <input type="date" name="date" class="form-control" {#value="{{ date }}"#}>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="bi bi-search me-2"></i>Rechercher
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
    <div class="row text-center mb-5 g-4 my-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="display-6 text-primary mb-2">🗺️</div>
                <h4 class="fw-bold">Trajets variés</h4>
                <p class="text-muted mb-0">Des centaines de destinations partout en France.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="display-6 text-primary mb-2">💶</div>
                <h4 class="fw-bold">Économique</h4>
                <p class="text-muted mb-0">Partagez les frais et voyagez à moindre coût.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="display-6 text-primary mb-2">🤝</div>
                <h4 class="fw-bold">Communauté</h4>
                <p class="text-muted mb-0">Des conducteurs et passagers vérifiés et bienveillants.</p>
            </div>
        </div>
    </div>
    
    <section class="py-5">
        <div class="container">
            <h2 class="h4 fw-bold mb-4">Prochains trajets disponibles</h2>

            {% if nextTrips is empty %}
                <div class="text-center text-muted py-5">
                    <p class="fs-5">Aucun trajet disponible pour le moment.</p>
                    {% if app.user %}
                        <a href="#" class="btn btn-primary">Proposer le premier trajet</a>
                    {% endif %}
                </div>
            {% else %}
                <div class="row g-4">
                    {% for trip in nextTrips %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm border-0 hover-shadow">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-success">{{ trip.availableSeats }} place{{ trip.availableSeats > 1 ? 's' : '' }}</span>
                                        <span class="fw-bold text-primary fs-5">{{ trip.pricePerSeat }}€</span>
                                    </div>

                                    <h5 class="card-title fw-bold">
                                        {{ trip.origin }} → {{ trip.destination }}
                                    </h5>

                                    <p class="text-muted small mb-1">
                                        📅 {{ trip.departureAt|date('d/m/Y à H:i') }}
                                    </p>
                                    <p class="text-muted small mb-3">
                                        🚗 {{ trip.vehicle.brand }} {{ trip.vehicle.model }}
                                    </p>

                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-muted small">
                                            👤 {{ trip.driver.firstName }} {{ trip.driver.lastName }}
                                        </span>
                                        <a href="{{ path('app_profile_trip_show', { id: trip.id }) }}" class="btn btn-outline-primary btn-sm">
                                            Voir
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="text-center mt-4">
                    <a href="#" class="btn btn-outline-primary">
                        Voir tous les trajets <i class="ri-arrow-right-long-fill me-1"></i>
                    </a>
                </div>
            {% endif %}
        </div>
    </section>


    <section class="bg-white py-5 border-top">
        <div class="container">
            <h2 class="h4 fw-bold text-center mb-5">Comment ça marche ?</h2>
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="fs-1 mb-3">🔍</div>
                    <h5 class="fw-bold">1. Recherchez</h5>
                    <p class="text-muted">Entrez votre ville de départ, d'arrivée et la date souhaitée.</p>
                </div>
                <div class="col-md-4">
                    <div class="fs-1 mb-3">✋</div>
                    <h5 class="fw-bold">2. Réservez</h5>
                    <p class="text-muted">Choisissez un trajet et réservez votre place en quelques secondes.</p>
                </div>
                <div class="col-md-4">
                    <div class="fs-1 mb-3">🚀</div>
                    <h5 class="fw-bold">3. Voyagez</h5>
                    <p class="text-muted">Retrouvez le conducteur et profitez du trajet ensemble.</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}