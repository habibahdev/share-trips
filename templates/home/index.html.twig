{% extends 'base.html.twig' %}

{% block title %}Share Trips - Le covoiturage partout en France{% endblock %}

{% block body %}
    {# hero + formulaire #}
    <section class="hero-section">
        <div class="container position-relative" style="z-index:2;">
            <div class="row justify-content-center text-center text-white">
                <div class="col-lg-7">
                    <span class="badge rounded-pill px-3 py-2 mb-4 fw-semibold"
                        style="background:rgba(96,165,250,0.2);color:#bfdbfe;font-size:.8rem;letter-spacing:.04em;">
                        <i class="bi bi-stars me-1"></i> Covoiturage simple &amp; économique
                    </span>
                    <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;line-height:1.15;margin-bottom:1rem;">
                        Phrase d'accorche<br>
                        <span style="color:#60a5fa;">pas d'idée pour.</span>
                    </h1>
                    <p style="font-size:1.15rem;opacity:.75;max-width:480px;margin:0 auto 0;">
                        Rejoignez des milliers de voyageurs qui partagent la route chaque jour partout en France.
                    </p>
                </div>
            </div>
        </div>
    </section>



    <div class="container" style="position:relative;z-index:10;margin-top:-4rem;">
        <div class="search-card">
            <form method="get" action="{{ path('app_home') }}">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <div class="search-label">
                            <i class="bi bi-geo-alt-fill me-1" style="color:#1d4ed8;"></i>Départ
                        </div>
                        <div class="autocomplete-wrapper position-relative">
                            <input type="text"
                                name="origin"
                                id="search_origin"
                                class="search-input form-control"
                                value="{{ origin ?? '' }}">
                        </div>
                    </div>
                    <div class="col-md-auto d-none d-md-flex align-items-center justify-content-center" style="padding-bottom:.5rem;">
                        <i class="bi bi-arrow-right" style="color:#cbd5e1;font-size:1.2rem;margin-top:1.5rem;"></i>
                    </div>
                    <div class="col-md-3">
                        <div class="search-label">
                            <i class="bi bi-geo-fill me-1" style="color:#1e3a5f;"></i>Arrivée
                        </div>
                        <div class="autocomplete-wrapper position-relative">
                            <input type="text"
                                name="destination"
                                id="search_destination"
                                class="search-input form-control"
                                value="{{ destination ?? '' }}">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="search-label">
                            <i class="bi bi-calendar3 me-1 text-secondary"></i>Date
                        </div>
                        <input type="date"
                            name="date"
                            class="search-input form-control"
                            value="{{ date ?? '' }}">
                    </div>
                    <div class="col-md-2">
                        <div class="search-label" style="opacity:0;">_</div>
                        <button type="submit" class="btn-search w-100">
                            <i class="bi bi-search me-2"></i>Rechercher
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>


    {# des chiffres #}
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row g-4 text-center">
                <div class="col-4">
                    <div style="font-size:2rem;font-weight:800;color:#1e3a5f;">Stat</div>
                    <div class="text-muted small fw-medium">Trajets publiés</div>
                </div>
                <div class="col-4" style="border-left:1.5px solid #f1f5f9;border-right:1.5px solid #f1f5f9;">
                    <div style="font-size:2rem;font-weight:800;color:#1d4ed8;">Stat</div>
                    <div class="text-muted small fw-medium">Sur les frais de transport</div>
                </div>
                <div class="col-4">
                    <div style="font-size:2rem;font-weight:800;color:#1e3a5f;">Stat <i class="bi bi-star-fill" style="font-size:1.2rem;color:#f59e0b;"></i></div>
                    <div class="text-muted small fw-medium">Note moyenne</div>
                </div>
            </div>
        </div>
    </section>


    {# liste des trajets #}
    <section class="py-5" style="background:#f8fafc;" id="trajets">
        <div class="container">

            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <span class="section-tag">Disponibles maintenant</span>
                    <h2 style="font-size:1.6rem;font-weight:800;color:#1e3a5f;margin:0;">Prochains départs</h2>
                </div>
                <a href="{{ path('app_trips') }}" style="color:#1d4ed8;font-weight:600;font-size:.9rem;text-decoration:none;">
                    Voir tout <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            {% if nextTrips is empty %}
                <div style="background:#fff;border-radius:20px;padding:3rem;text-align:center;border:1.5px solid #f1f5f9;">
                    <i class="bi bi-signpost-2 d-block mb-3" style="font-size:3rem;color:#bfdbfe;"></i>
                    <p class="text-muted mb-3" style="font-size:1.1rem;">Aucun trajet disponible pour le moment.</p>
                    {% if app.user %}
                        <a href="#" class="btn-reserve px-4 py-2 text-decoration-none d-inline-block">
                            <i class="bi bi-plus-circle me-2"></i>Proposer le premier trajet
                        </a>
                    {% endif %}
                </div>
            {% else %}
                <div class="row g-3">
                    {% for trip in nextTrips %}
                        <div class="col-12">
                            <div class="trip-card d-flex align-items-center gap-4">

                                {# Avatar #}
                                <div class="avatar d-none d-md-flex">
                                    {{ trip.driver.firstName ? trip.driver.firstName|first|upper : '?' }}
                                </div>

                                {# Route visuelle #}
                                <div class="d-none d-md-flex flex-column align-items-center" style="width:12px;height:52px;">
                                    <div class="route-dot" style="background:#1d4ed8;"></div>
                                    <div class="route-line"></div>
                                    <div class="route-dot" style="background:#1e3a5f;"></div>
                                </div>

                                {# Villes + date #}
                                <div style="flex:1;min-width:0;">
                                    <div style="font-weight:700;color:#1e3a5f;font-size:1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        {{ trip.origin }}
                                    </div>
                                    <div style="font-weight:600;color:#475569;font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        {{ trip.destination }}
                                    </div>
                                    <div style="font-size:.8rem;color:#94a3b8;margin-top:.2rem;">
                                        <i class="bi bi-calendar3 me-1"></i>{{ trip.departureAt|date('d/m/Y') }}
                                        <span class="divider-dot mx-2"></span>
                                        <i class="bi bi-clock me-1"></i>{{ trip.departureAt|date('H:i') }}
                                    </div>
                                </div>

                                {# Conducteur #}
                                <div class="d-none d-lg-block" style="min-width:130px;">
                                    <div style="font-weight:600;font-size:.875rem;color:#334155;">
                                        {{ trip.driver.firstName ?? '' }} {{ trip.driver.lastName ?? '' }}
                                    </div>
                                    <div style="font-size:.8rem;color:#94a3b8;">
                                        <i class="bi bi-car-front me-1"></i>{{ trip.vehicle.brand }} {{ trip.vehicle.model }}
                                    </div>
                                </div>

                                {# Places #}
                                <div class="d-none d-md-block text-center" style="min-width:80px;">
                                    {% if trip.status.value == 'open' %}
                                        <div style="font-weight:700;color:#1e3a5f;font-size:.95rem;">{{ trip.availableSeats }}</div>
                                        <div style="font-size:.75rem;color:#94a3b8;">place{{ trip.availableSeats > 1 ? 's' : '' }}</div>
                                    {% elseif trip.status.value == 'full' %}
                                        <span style="background:#fef9c3;color:#854d0e;font-size:.72rem;font-weight:700;border-radius:8px;padding:.25rem .65rem;">
                                            Complet
                                        </span>
                                    {% elseif trip.status.value == 'cancelled' %}
                                        <span style="background:#fee2e2;color:#991b1b;font-size:.72rem;font-weight:700;border-radius:8px;padding:.25rem .65rem;">
                                            Annulé
                                        </span>
                                    {% endif %}
                                </div>

                                {# Prix + bouton #}
                                <div class="d-flex align-items-center gap-3 ms-auto">
                                    <span class="price-pill">{{ trip.pricePerSeat }}€</span>
                                    {% if trip.status.value == 'open' %}
                                        <a href="{{ path('app_booking_add', { trip: trip.id }) }}" class="btn-reserve text-decoration-none">
                                            Réserver
                                        </a>
                                    {% else %}
                                        <span class="btn-reserve text-decoration-none"
                                            style="opacity:.4;cursor:not-allowed;pointer-events:none;">
                                            {% if trip.status.value == 'full' %}Complet{% else %}Indispo{% endif %}
                                        </span>
                                    {% endif %}
                                </div>

                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </section>


    {# pourquoi choisir sharetrip #}
    <section class="py-5 bg-white">
        <div class="container">
            <div class="text-center mb-5">
                <span class="section-tag">Pourquoi nous choisir</span>
                <h2 style="font-size:1.6rem;font-weight:800;color:#1e3a5f;margin:0;">Simple, économique, humain.</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-3 col-sm-6">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="benefit-icon" style="background:#eff6ff;">
                            <i class="bi bi-piggy-bank" style="color:#1d4ed8;"></i>
                        </div>
                        <div>
                            <h6 style="font-weight:700;color:#1e3a5f;margin-bottom:.3rem;">Économisez</h6>
                            <p class="text-muted small mb-0">Jusqu'à 60% moins cher que le train.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="benefit-icon" style="background:#eff6ff;">
                            <i class="bi bi-shield-check" style="color:#1d4ed8;"></i>
                        </div>
                        <div>
                            <h6 style="font-weight:700;color:#1e3a5f;margin-bottom:.3rem;">En sécurité</h6>
                            <p class="text-muted small mb-0">Profils vérifiés, avis communauté.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="benefit-icon" style="background:#eff6ff;">
                            <i class="bi bi-tree" style="color:#1d4ed8;"></i>
                        </div>
                        <div>
                            <h6 style="font-weight:700;color:#1e3a5f;margin-bottom:.3rem;">Écologique</h6>
                            <p class="text-muted small mb-0">Réduisez votre empreinte carbone.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="benefit-icon" style="background:#eff6ff;">
                            <i class="bi bi-people" style="color:#1d4ed8;"></i>
                        </div>
                        <div>
                            <h6 style="font-weight:700;color:#1e3a5f;margin-bottom:.3rem;">Convivial</h6>
                            <p class="text-muted small mb-0">Voyagez en bonne compagnie.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    {# les étapes #}
    <section class="py-5" style="background:#f8fafc;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="section-tag">3 étapes</span>
                <h2 style="font-size:1.6rem;font-weight:800;color:#1e3a5f;margin:0;">Comment ça marche ?</h2>
            </div>
            <div class="row g-5 align-items-start justify-content-center">
                <div class="col-md-4">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="step-number">1</div>
                        <div>
                            <h5 style="font-weight:700;color:#1e3a5f;margin-bottom:.4rem;">Recherchez</h5>
                            <p class="text-muted small mb-0">Entrez votre départ, arrivée et la date. Les résultats s'affichent instantanément.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="step-number">2</div>
                        <div>
                            <h5 style="font-weight:700;color:#1e3a5f;margin-bottom:.4rem;">Réservez</h5>
                            <p class="text-muted small mb-0">Choisissez un trajet et réservez votre place en quelques secondes.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="step-number">3</div>
                        <div>
                            <h5 style="font-weight:700;color:#1e3a5f;margin-bottom:.4rem;">Voyagez</h5>
                            <p class="text-muted small mb-0">Retrouvez votre conducteur et profitez du trajet ensemble.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    

    {% if not app.user %}
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="cta-card cta-driver">
                        <i class="bi bi-car-front d-block mb-3" style="font-size:2rem;color:#93c5fd;"></i>
                        <h4 style="font-weight:800;margin-bottom:.5rem;">Vous êtes conducteur ?</h4>
                        <p style="opacity:.8;font-size:.95rem;margin-bottom:1.5rem;">
                            Publiez vos trajets, partagez vos frais et rencontrez de nouvelles personnes.
                        </p>
                        <a href="{{ path('app_register') }}" class="btn-cta-white text-decoration-none d-inline-block">
                            <i class="bi bi-plus-circle me-2"></i>Créer un compte
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="cta-card cta-passenger">
                        <i class="bi bi-backpack d-block mb-3" style="font-size:2rem;color:#1d4ed8;"></i>
                        <h4 style="font-weight:800;color:#1e3a5f;margin-bottom:.5rem;">Vous êtes passager ?</h4>
                        <p style="color:#475569;font-size:.95rem;margin-bottom:1.5rem;">
                            Trouvez un trajet, réservez en quelques clics et voyagez sereinement.
                        </p>
                        <a href="{{ path('app_register') }}" class="btn-cta-dark text-decoration-none d-inline-block">
                            <i class="bi bi-person-plus me-2"></i>S'inscrire gratuitement
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    {% endif %}

{% endblock %}