{% extends 'base.html.twig' %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <a href="{{ path('app_profile') }}" class="text-decoration-none text-muted small">
                    ⬅️ Mon profil
                </a>
                <h1 class="h3 fw-bold mt-1 mb-4">Modifier mes infos</h1>
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">Prénom</label>
                                        {{ form_widget(form.firstName, {'attr': {'class': 'form-control' ~ (form.firstName.vars.errors|length ? ' is-invalid' : '')}}) }}
                                        {{ form_errors(form.firstName) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">Nom</label>
                                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control' ~ (form.lastName.vars.errors|length ? ' is-invalid' : '')}}) }}
                                    {{ form_errors(form.lastName) }}
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-medium">Adresse email</label>
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control' }}) }}
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-medium">Téléphone</label>
                                    {{ form_widget(form.phone, {'attr': {'class': 'form-control' ~ (form.phone.vars.errors|length ? ' is-invalid' : '')}}) }}
                                    {{ form_errors(form.phone) }}
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-4">
                                <button type="submit" class="btn btn-primary px-4">
                                    💾 Enregistrer
                                </button>
                                <a href="{{ path('app_profile') }}" class="btn btn-outline-secondary">Annuler</a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
