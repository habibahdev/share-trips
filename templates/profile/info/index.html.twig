{% extends 'base.html.twig' %}

{% block body %}
<div class="edit-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">

                <a href="{{ path('app_profile') }}" class="back-link mb-3 d-inline-flex">
                    <i class="bi bi-arrow-left"></i> Mon profil
                </a>

                <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:.5rem 0 1.5rem;">
                    Modifier mes informations
                </h1>

                <div class="edit-card">

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="edit-label">
                                    <i class="bi bi-person me-1"></i>Prénom
                                </label>
                                {{ form_widget(form.firstName, {
                                    'attr': {
                                        'class': 'edit-input' ~ (form.firstName.vars.errors|length ? ' is-invalid' : ''),
                                        'placeholder': 'Votre prénom'
                                    }
                                }) }}
                                {% if form.firstName.vars.errors|length %}
                                    {% for error in form.firstName.vars.errors %}
                                        <div class="invalid-feedback-st">
                                            <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>

                            <div class="col-md-6">
                                <label class="edit-label">
                                    <i class="bi bi-person me-1"></i>Nom
                                </label>
                                {{ form_widget(form.lastName, {
                                    'attr': {
                                        'class': 'edit-input' ~ (form.lastName.vars.errors|length ? ' is-invalid' : ''),
                                        'placeholder': 'Votre nom'
                                    }
                                }) }}
                                {% if form.lastName.vars.errors|length %}
                                    {% for error in form.lastName.vars.errors %}
                                        <div class="invalid-feedback-st">
                                            <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>

                            <div class="col-12">
                                <label class="edit-label">
                                    <i class="bi bi-envelope me-1"></i>Adresse email
                                </label>
                                {{ form_widget(form.email, {
                                    'attr': {
                                        'class': 'edit-input' ~ (form.email.vars.errors|length ? ' is-invalid' : ''),
                                        'placeholder': 'vous@exemple.fr'
                                    }
                                }) }}
                                {% if form.email.vars.errors|length %}
                                    {% for error in form.email.vars.errors %}
                                        <div class="invalid-feedback-st">
                                            <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>

                            <div class="col-12">
                                <label class="edit-label">
                                    <i class="bi bi-telephone me-1"></i>Téléphone
                                    <span style="text-transform:none;letter-spacing:0;font-weight:400;color:#cbd5e1;margin-left:4px;">(optionnel)</span>
                                </label>
                                {{ form_widget(form.phone, {
                                    'attr': {
                                        'class': 'edit-input' ~ (form.phone.vars.errors|length ? ' is-invalid' : ''),
                                        'placeholder': '06 00 00 00 00'
                                    }
                                }) }}
                                {% if form.phone.vars.errors|length %}
                                    {% for error in form.phone.vars.errors %}
                                        <div class="invalid-feedback-st">
                                            <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn-save">
                                <i class="bi bi-check2"></i> Enregistrer
                            </button>
                            <a href="{{ path('app_profile') }}" class="btn-cancel">
                                Annuler
                            </a>
                        </div>

                    {{ form_end(form) }}

                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}
