{% extends 'base.html.twig' %}

{% block title %}Mes réservations — Share Trips{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .bookings-page { font-family:'Plus Jakarta Sans',sans-serif;background:#f8fafc;min-height:calc(100vh - 70px);padding:2.5rem 0; }
        .booking-row { background:#fff;border-radius:16px;border:1.5px solid #f1f5f9;padding:1.25rem 1.5rem;transition:border-color .2s,box-shadow .2s,transform .15s; }
        .booking-row:hover { border-color:#dbeafe;box-shadow:0 6px 20px rgba(30,58,95,.07);transform:translateY(-1px); }
        .empty-card { background:#fff;border-radius:20px;border:1.5px solid #f1f5f9;padding:2rem; }
        .route-badge { display:inline-flex;align-items:center;gap:5px;background:#eff6ff;color:#1e3a5f;font-size:.8rem;font-weight:700;border-radius:8px;padding:.3rem .75rem; }
        .trip-meta { font-size:.8rem;color:#94a3b8;display:flex;align-items:center;gap:5px; }
        .price-tag { font-size:1.1rem;font-weight:800;color:#1e3a5f; }
        .status-badge { font-size:.72rem;font-weight:700;border-radius:8px;padding:.25rem .7rem;display:inline-block; }
        .status-confirmed { background:#dcfce7;color:#166534; }
        .status-pending { background:#fef9c3;color:#854d0e; }
        .status-cancelled { background:#f1f5f9;color:#475569; }
        .seats-badge { background:#eff6ff;color:#1d4ed8;font-size:.75rem;font-weight:700;border-radius:8px;padding:.2rem .65rem;display:inline-flex;align-items:center;gap:4px; }
        .btn-detail { height:34px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:600;border:1.5px solid #f1f5f9;background:#f8fafc;color:#475569;text-decoration:none;padding:0 .9rem;transition:background .15s,color .15s;font-family:'Plus Jakarta Sans',sans-serif;gap:5px; }
        .btn-detail:hover { background:#f1f5f9;color:#1e3a5f; }
        .btn-cancel-booking { height:34px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:600;border:1.5px solid #fecaca;background:#fff;color:#dc2626;padding:0 .9rem;transition:background .15s;font-family:'Plus Jakarta Sans',sans-serif;gap:5px;cursor:pointer; }
        .btn-cancel-booking:hover { background:#fee2e2; }
        .btn-report-link { height:34px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:600;border:1.5px solid #fecaca;background:#fff;color:#dc2626;padding:0 .9rem;text-decoration:none;gap:5px;transition:background .15s;font-family:'Plus Jakarta Sans',sans-serif; }
        .btn-report-link:hover { background:#fee2e2; }
        .btn-new { background:#1e3a5f;color:#fff;border:none;border-radius:12px;padding:.6rem 1.25rem;font-size:.875rem;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:background .2s; }
        .btn-new:hover { background:#1d4ed8;color:#fff; }
        .back-link { font-size:.82rem;font-weight:600;color:#94a3b8;text-decoration:none;display:inline-flex;align-items:center;gap:5px;transition:color .15s; }
        .back-link:hover { color:#1e3a5f; }

        /* Formulaire de recherche */
        .search-section { background:#fff;border-radius:16px;border:1.5px solid #f1f5f9;padding:1.5rem;margin-bottom:1.5rem; }
        .search-section-title { font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;margin-bottom:1rem;display:flex;align-items:center;gap:6px; }
        .search-input { border:2px solid #f1f5f9;border-radius:12px;padding:.65rem 1rem;font-size:.875rem;font-family:'Plus Jakarta Sans',sans-serif;background:#f8fafc;transition:border-color .2s,background .2s;width:100%; }
        .search-input:focus { border-color:#1d4ed8;background:#fff;box-shadow:0 0 0 4px rgba(29,78,216,.08);outline:none; }
        .search-label { font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#64748b;margin-bottom:.3rem;display:block; }
        .btn-search { background:#1e3a5f;color:#fff;border:none;border-radius:12px;padding:.65rem 1.25rem;font-size:.875rem;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;transition:background .2s;cursor:pointer;display:inline-flex;align-items:center;gap:6px;width:100%; justify-content:center; }
        .btn-search:hover { background:#1d4ed8; }

        /* Résultats de recherche */
        .trip-row { background:#fff;border-radius:16px;border:1.5px solid #f1f5f9;padding:1.25rem 1.5rem;transition:border-color .2s,box-shadow .2s,transform .15s; }
        .trip-row:hover { border-color:#dbeafe;box-shadow:0 6px 20px rgba(30,58,95,.07);transform:translateY(-1px); }
        .results-title { font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;margin-bottom:1rem;display:flex;align-items:center;gap:6px; }
    </style>
{% endblock %}

{% block body %}
<div class="bookings-page">
    <div class="container">

        {# ===== EN-TÊTE ===== #}
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <a href="{{ path('app_profile') }}" class="back-link mb-2 d-inline-flex">
                    <i class="bi bi-arrow-left"></i> Mon profil
                </a>
                <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:.25rem 0 .2rem;">Mes réservations</h1>
                <p style="font-size:.85rem;color:#94a3b8;margin:0;">Trajets réservés en tant que passager</p>
            </div>
        </div>

        {% if bookings is empty %}

            {# ===== ÉTAT VIDE + RECHERCHE ===== #}
            <div class="empty-card mb-4">
                <div class="text-center py-3 mb-4" style="border-bottom:1.5px solid #f1f5f9;">
                    <i class="bi bi-ticket-perforated d-block mb-2" style="font-size:2.5rem;color:#bfdbfe;"></i>
                    <h5 style="font-weight:800;color:#1e3a5f;margin-bottom:.3rem;">Aucune réservation</h5>
                    <p style="font-size:.875rem;color:#94a3b8;margin:0;">Recherchez un trajet ci-dessous pour commencer.</p>
                </div>

                {# Formulaire de recherche #}
                <div class="search-section-title">
                    <i class="bi bi-search"></i> Rechercher un trajet
                </div>

                <form method="get" action="{{ path('app_profile_booking') }}">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="search-label">
                                <i class="bi bi-geo-alt-fill me-1" style="color:#1d4ed8;"></i>Départ
                            </label>
                            <div class="autocomplete-wrapper position-relative">
                                <input type="text"
                                       name="origin"
                                       id="search_origin"
                                       class="search-input"
                                       placeholder="Ville de départ"
                                       value="{{ origin ?? '' }}">
                            </div>
                        </div>
                        <div class="col-md-auto d-none d-md-flex align-items-end pb-1">
                            <i class="bi bi-arrow-right" style="color:#cbd5e1;font-size:1.1rem;margin-bottom:.75rem;"></i>
                        </div>
                        <div class="col-md-3">
                            <label class="search-label">
                                <i class="bi bi-geo-fill me-1" style="color:#1e3a5f;"></i>Arrivée
                            </label>
                            <div class="autocomplete-wrapper position-relative">
                                <input type="text"
                                       name="destination"
                                       id="search_destination"
                                       class="search-input"
                                       placeholder="Ville d'arrivée"
                                       value="{{ destination ?? '' }}">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="search-label">
                                <i class="bi bi-calendar3 me-1 text-secondary"></i>Date
                            </label>
                            <input type="date"
                                   name="date"
                                   class="search-input"
                                   value="{{ date ?? '' }}">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn-search">
                                <i class="bi bi-search"></i> Rechercher
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            {# ===== RÉSULTATS ===== #}
            {% if availableTrips is not null %}
                {% if availableTrips is empty %}
                    <div style="background:#fff;border-radius:16px;border:1.5px solid #f1f5f9;padding:2rem;text-align:center;">
                        <i class="bi bi-signpost-2 d-block mb-2" style="font-size:2rem;color:#bfdbfe;"></i>
                        <p style="color:#94a3b8;font-size:.875rem;margin:0;">Aucun trajet trouvé pour ces critères.</p>
                    </div>
                {% else %}
                    <div class="results-title">
                        <i class="bi bi-map"></i>
                        {{ availableTrips|length }} trajet{{ availableTrips|length > 1 ? 's' : '' }} disponible{{ availableTrips|length > 1 ? 's' : '' }}
                    </div>
                    <div class="d-flex flex-column gap-3">
                        {% for trip in availableTrips %}
                            <div class="trip-row">
                                <div class="row align-items-center g-3">
                                    <div class="col-md-4">
                                        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                                            <span class="route-badge">
                                                <i class="bi bi-geo-alt-fill" style="color:#1d4ed8;font-size:.7rem;"></i>
                                                {{ trip.origin }}
                                            </span>
                                            <i class="bi bi-arrow-right" style="color:#cbd5e1;font-size:.85rem;"></i>
                                            <span class="route-badge">
                                                <i class="bi bi-geo-fill" style="color:#1e3a5f;font-size:.7rem;"></i>
                                                {{ trip.destination }}
                                            </span>
                                        </div>
                                        <div class="trip-meta">
                                            <i class="bi bi-calendar3"></i>{{ trip.departureAt|date('d/m/Y à H:i') }}
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="trip-meta mb-1">
                                            <i class="bi bi-person"></i>
                                            {{ trip.driver.firstName ?? '' }} {{ trip.driver.lastName ?? '' }}
                                        </div>
                                        <div class="trip-meta">
                                            <i class="bi bi-car-front"></i>
                                            {{ trip.vehicle.brand }} {{ trip.vehicle.model }}
                                        </div>
                                    </div>
                                    <div class="col-md-2 text-md-center">
                                        <span class="seats-badge">
                                            <i class="bi bi-person-check"></i>
                                            {{ trip.availableSeats }} place{{ trip.availableSeats > 1 ? 's' : '' }}
                                        </span>
                                    </div>
                                    <div class="col-md-3 d-flex align-items-center justify-content-md-end gap-3">
                                        <span class="price-tag">{{ trip.pricePerSeat }}€</span>
                                        <a href="{{ path('app_trip_show', { id: trip.id }) }}" class="btn-new">
                                            Voir
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}

        {% else %}

            {# ===== LISTE DES RÉSERVATIONS ===== #}
            <div class="d-flex flex-column gap-3">
                {% for booking in bookings %}
                    <div class="booking-row">
                        <div class="row align-items-center g-3">

                            <div class="col-md-4">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                                    <span class="route-badge">
                                        <i class="bi bi-geo-alt-fill" style="color:#1d4ed8;font-size:.7rem;"></i>
                                        {{ booking.trip.origin }}
                                    </span>
                                    <i class="bi bi-arrow-right" style="color:#cbd5e1;font-size:.85rem;"></i>
                                    <span class="route-badge">
                                        <i class="bi bi-geo-fill" style="color:#1e3a5f;font-size:.7rem;"></i>
                                        {{ booking.trip.destination }}
                                    </span>
                                </div>
                                <div class="trip-meta">
                                    <i class="bi bi-calendar3"></i>{{ booking.trip.departureAt|date('d/m/Y à H:i') }}
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="trip-meta mb-1">
                                    <i class="bi bi-person"></i>
                                    {{ booking.trip.driver.firstName ?? '' }} {{ booking.trip.driver.lastName ?? '' }}
                                </div>
                                <div class="trip-meta">
                                    <i class="bi bi-person-check"></i>
                                    {{ booking.seatsBooked }} place{{ booking.seatsBooked > 1 ? 's' : '' }} réservée{{ booking.seatsBooked > 1 ? 's' : '' }}
                                </div>
                            </div>

                            <div class="col-md-2 text-md-center">
                                <div class="price-tag mb-1">{{ booking.seatsBooked * booking.trip.pricePerSeat }}€</div>
                                <span class="status-badge
                                    {% if booking.status.value == 'confirmed' %}status-confirmed
                                    {% elseif booking.status.value == 'pending' %}status-pending
                                    {% else %}status-cancelled{% endif %}">
                                    {% if booking.status.value == 'confirmed' %}Confirmée
                                    {% elseif booking.status.value == 'pending' %}En attente
                                    {% else %}Annulée{% endif %}
                                </span>
                            </div>

                            <div class="col-md-3 d-flex gap-2 justify-content-md-end flex-wrap">
                                <a href="{{ path('app_profile_booking_show', { booking: booking.id }) }}" class="btn-detail">
                                    <i class="bi bi-eye"></i> Détail
                                </a>
                                {% if booking.status.value != 'cancelled' %}
                                    <form method="post" action="{{ path('app_profile_booking_cancel', { booking: booking.id }) }}"
                                          onsubmit="return confirm('Annuler cette réservation ?')"
                                          style="display:contents;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_booking_' ~ booking.id) }}">
                                        <button type="submit" class="btn-cancel-booking">
                                            <i class="bi bi-x-lg"></i> Annuler
                                        </button>
                                    </form>
                                {% endif %}
                                {% if booking.status.value == 'confirmed' and booking.trip.departureAt < date() %}
                                    <a href="{{ path('app_report_add', { id: booking.id }) }}" class="btn-report-link">
                                        <i class="bi bi-flag"></i> Signaler
                                    </a>
                                {% endif %}
                            </div>

                        </div>
                    </div>
                {% endfor %}
            </div>

        {% endif %}

    </div>
</div>
{% endblock %}