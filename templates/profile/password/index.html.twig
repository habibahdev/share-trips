{% extends 'base.html.twig' %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <a href="{{ path('app_profile') }}" class="text-decoration-none text-muted small">
                    ⬅️ Mon profil
                </a>
                <h1 class="h3 fw-bold mt-1 mb-4">Changer le mot de passe</h1>
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                        <div class="mb-3">
                            <label class="form-label fw-medium">Mot de passe actuel</label>
                            {{ form_widget(form.actualPassword, {'attr': {'class': 'form-control' ~ (form.actualPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.actualPassword) }}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Nouveau mot de passe</label>
                            {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control' ~ (form.newPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">Confirmez le nouveau mot de passe</label>
                            {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control' ~ (form.newPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.newPassword) }}
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">💾 Enregistrer</button>
                            <a href="{{ path('app_profile') }}" class="btn btn-outline-secondary rounded-pill px-4">Annuler</a>
                        </div>
                    {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
