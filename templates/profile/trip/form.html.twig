{% extends 'base.html.twig' %}

{% block title %}Mon profil : ajouter un trajet - Share Trips{% endblock %}

{% block body %}
<div class="trip-form-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">

                <a href="{{ path('app_profile_trip') }}" class="back-link mb-3 d-inline-flex">
                    <i class="bi bi-arrow-left"></i> Mes trajets
                </a>

                <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:.5rem 0 1.5rem;">
                    {{ title }}
                </h1>

                <div class="form-card">

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="section-label">
                            <i class="bi bi-map"></i> Itinéraire
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="trip-label">
                                    <i class="bi bi-geo-alt-fill me-1" style="color:#1d4ed8;"></i>Ville de départ
                                </label>
                                <div class="autocomplete-wrapper position-relative">
                                    {{ form_widget(form.origin, {
                                        'attr': {
                                            'class': 'trip-input' ~ (form.origin.vars.errors|length ? ' is-invalid' : ''),
                                            'id': 'trip_origin',
                                            'autocomplete': 'off'
                                        }
                                    }) }}
                                </div>
                                
                                {% if form.origin.vars.errors|length %}
                                    {% for error in form.origin.vars.errors %}
                                        <div class="invalid-feedback-st">
                                            <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <label class="trip-label">
                                    <i class="bi bi-geo-fill me-1" style="color:#1e3a5f;"></i>Ville d'arrivée
                                </label>
                                <div class="autocomplete-wrapper position-relative">
                                    {{ form_widget(form.destination, {
                                        'attr': {
                                            'class': 'trip-input' ~ (form.destination.vars.errors|length ? ' is-invalid' : ''),
                                            'id': 'trip_destination',
                                            'autocomplete': 'off'
                                        }
                                    }) }}
                                </div>
                                {% if form.destination.vars.errors|length %}
                                    {% for error in form.destination.vars.errors %}
                                        <div class="invalid-feedback-st">
                                            <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>

                        <hr class="section-divider">

                        <div class="section-label">
                            <i class="bi bi-calendar3"></i> Date &amp; tarif
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="trip-label">
                                    <i class="bi bi-calendar3 me-1"></i>Date et heure de départ
                                </label>
                                {{ form_widget(form.departureAt, {
                                    'attr': {
                                        'class': 'trip-input' ~ (form.departureAt.vars.errors|length ? ' is-invalid' : '')
                                    }
                                }) }}
                                {% if form.departureAt.vars.errors|length %}
                                    {% for error in form.departureAt.vars.errors %}
                                        <div class="invalid-feedback-st">
                                            <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <label class="trip-label">
                                    <i class="bi bi-person-check me-1"></i>Places proposées
                                </label>
                                {{ form_widget(form.availableSeats, {
                                    'attr': {
                                        'class': 'trip-input' ~ (form.availableSeats.vars.errors|length ? ' is-invalid' : ''),
                                        'min': 1, 'max': 8
                                    }
                                }) }}
                                {% if form.availableSeats.vars.errors|length %}
                                    {% for error in form.availableSeats.vars.errors %}
                                        <div class="invalid-feedback-st">
                                            <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <label class="trip-label">
                                    <i class="bi bi-cash-coin me-1"></i>Prix par place (€)
                                </label>
                                {{ form_widget(form.pricePerSeat, {
                                    'attr': {
                                        'class': 'trip-input' ~ (form.pricePerSeat.vars.errors|length ? ' is-invalid' : '')
                                    }
                                }) }}
                                {% if form.pricePerSeat.vars.errors|length %}
                                    {% for error in form.pricePerSeat.vars.errors %}
                                        <div class="invalid-feedback-st">
                                            <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>

                        <hr class="section-divider">

                        <div class="section-label">
                            <i class="bi bi-car-front"></i> Véhicule
                        </div>

                        <div class="mb-4">
                            {{ form_widget(form.vehicle, {
                                'attr': {
                                    'class': 'trip-input' ~ (form.vehicle.vars.errors|length ? ' is-invalid' : '')
                                }
                            }) }}
                            {% if form.vehicle.vars.errors|length %}
                                {% for error in form.vehicle.vars.errors %}
                                    <div class="invalid-feedback-st">
                                        <i class="bi bi-exclamation-circle-fill"></i>{{ error.message }}
                                    </div>
                                {% endfor %}
                            {% endif %}
                            <a href="{{ path('app_profile_vehicle_form') }}" target="_blank" class="add-vehicle-link">
                                <i class="bi bi-plus-circle"></i> Ajouter un véhicule
                            </a>
                        </div>

                        <hr class="section-divider">

                        <div class="show-card mb-4">
                            <div class="card-section-title">
                                <i class="bi bi-signpost-split"></i> Points d'arrêt intermédiaires
                                <span style="font-size:.75rem;color:#94a3b8;font-weight:400;margin-left:.5rem;">
                                    (optionnel)
                                </span>
                            </div>

                            <div id="stops-container">
                                {% for stop in form.stops %}
                                    <div class="stop-row" data-index="{{ loop.index0 }}">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <div style="width:28px;height:28px;border-radius:50%;background:#dbeafe;
                                                        color:#1d4ed8;font-weight:700;font-size:.8rem;
                                                        display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                                {{ loop.index }}
                                            </div>
                                            <div class="flex-grow-1">
                                                {{ form_widget(stop.city) }}
                                            </div>
                                            <div style="width:200px;flex-shrink:0;">
                                                {{ form_widget(stop.extraPrice) }}
                                            </div>
                                            <button type="button" class="btn-stop-remove" onclick="removeStop(this)"
                                                    style="width:36px;height:36px;border-radius:10px;
                                                        border:1.5px solid #fee2e2;background:#fff;
                                                        color:#dc2626;cursor:pointer;flex-shrink:0;
                                                        display:flex;align-items:center;justify-content:center;">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                        {{ form_errors(stop.city) }}
                                        {{ form_errors(stop.extraPrice) }}
                                    </div>
                                {% endfor %}
                            </div>

                            {# Prototype caché #}
                            <div id="stops-prototype"
                                data-prototype="{{ form_widget(form.stops.vars.prototype)|e('html_attr') }}"
                                style="display:none;"></div>

                            <button type="button" id="add-stop"
                                    style="margin-top:.75rem;border:1.5px dashed #bfdbfe;background:transparent;
                                        border-radius:12px;padding:.6rem 1.25rem;color:#1d4ed8;
                                        font-weight:600;font-size:.85rem;cursor:pointer;width:100%;
                                        transition:background .15s;">
                                <i class="bi bi-plus-circle me-2"></i>Ajouter un arrêt
                            </button>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn-save">
                                <i class="bi bi-check2"></i>
                                {{ trip ? 'Enregistrer' : 'Publier le trajet' }}
                            </button>
                            <a href="{{ path('app_profile_trip') }}" class="btn-cancel">
                                Annuler
                            </a>
                        </div>

                    {{ form_end(form) }}

                </div>

            </div>
        </div>
    </div>
</div>

<script>
let stopIndex = {{ form.stops|length }};

document.getElementById('add-stop').addEventListener('click', function () {
    const container  = document.getElementById('stops-container');
    const prototype  = document.getElementById('stops-prototype').dataset.prototype;
    const newRow     = document.createElement('div');
    newRow.className = 'stop-row';
    newRow.dataset.index = stopIndex;

    newRow.innerHTML = prototype.replace(/__name__/g, stopIndex);

    // Ajouter le bouton supprimer
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.innerHTML = '<i class="bi bi-trash"></i>';
    removeBtn.setAttribute('onclick', 'removeStop(this)');
    removeBtn.style.cssText = 'width:36px;height:36px;border-radius:10px;border:1.5px solid #fee2e2;background:#fff;color:#dc2626;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;';

    // Restructurer en ligne
    const wrapper = document.createElement('div');
    wrapper.className = 'd-flex align-items-center gap-2 mb-2';

    const badge = document.createElement('div');
    badge.style.cssText = 'width:28px;height:28px;border-radius:50%;background:#dbeafe;color:#1d4ed8;font-weight:700;font-size:.8rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;';
    badge.textContent = stopIndex + 1;

    const inputs = newRow.querySelectorAll('input');
    inputs[0].className = 'login-input';
    inputs[0].placeholder = "Ville d'arrêt";
    if (inputs[1]) {
        inputs[1].className = 'login-input';
        inputs[1].placeholder = 'Prix supplémentaire (€)';
        inputs[1].style.width = '200px';
    }

    const cityWrap = document.createElement('div');
    cityWrap.className = 'flex-grow-1';
    cityWrap.appendChild(inputs[0]);

    wrapper.appendChild(badge);
    wrapper.appendChild(cityWrap);
    if (inputs[1]) wrapper.appendChild(inputs[1]);
    wrapper.appendChild(removeBtn);

    newRow.innerHTML = '';
    newRow.appendChild(wrapper);

    container.appendChild(newRow);
    stopIndex++;
    updateBadges();
});

function removeStop(btn) {
    btn.closest('.stop-row').remove();
    updateBadges();
}

function updateBadges() {
    document.querySelectorAll('.stop-row').forEach((row, i) => {
        const badge = row.querySelector('div[style*="border-radius:50%"]');
        if (badge) badge.textContent = i + 1;
    });
}
</script>
{% endblock %}