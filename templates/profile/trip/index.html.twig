{% extends 'base.html.twig' %}

{% block title %}Mon profil : mes trajets - Share Trips{% endblock %}

{% block body %}
<div class="trips-page">
    <div class="container">

        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <a href="{{ path('app_profile') }}" class="back-link mb-2 d-inline-flex">
                    <i class="bi bi-arrow-left"></i> Mon profil
                </a>
                <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:.25rem 0 .2rem;">Mes trajets</h1>
                <p style="font-size:.85rem;color:#94a3b8;margin:0;">Trajets proposés en tant que conducteur</p>
            </div>
            <a href="{{ path('app_profile_trip_form') }}" class="btn-new mt-1">
                <i class="bi bi-plus-lg"></i> Publier un trajet
            </a>
        </div>

        {% if trips is empty %}
            <div class="empty-card">
                <i class="bi bi-map d-block mb-3" style="font-size:3rem;color:#bfdbfe;"></i>
                <h5 style="font-weight:800;color:#1e3a5f;margin-bottom:.5rem;">Aucun trajet publié</h5>
                <p class="text-muted mb-4" style="font-size:.9rem;">Proposez votre premier trajet et partagez vos frais.</p>
                <a href="{{ path('app_profile_trip_form') }}" class="btn-new"><i class="bi bi-plus-lg"></i> Publier un trajet</a>
            </div>
        {% else %}
            <div class="d-flex flex-column gap-3">
                {% for trip in trips %}
                    <div class="trip-row">
                        <div class="row align-items-center g-3">
                            <div class="col-md-4">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                                    <span class="route-badge"><i class="bi bi-geo-alt-fill" style="color:#1d4ed8;font-size:.7rem;"></i>{{ trip.origin }}</span>
                                    <i class="bi bi-arrow-right" style="color:#cbd5e1;font-size:.85rem;"></i>
                                    <span class="route-badge"><i class="bi bi-geo-fill" style="color:#1e3a5f;font-size:.7rem;"></i>{{ trip.destination }}</span>
                                </div>
                                <div class="trip-meta"><i class="bi bi-calendar3"></i>{{ trip.departureAt|date('d/m/Y à H:i') }}</div>
                            </div>
                            <div class="col-md-3">
                                <div class="trip-meta mb-1"><i class="bi bi-car-front"></i>{{ trip.vehicle.brand }} {{ trip.vehicle.model }}</div>
                                <div class="trip-meta"><i class="bi bi-person-check"></i>{{ trip.availableSeats }} place{{ trip.availableSeats > 1 ? 's' : '' }} dispo</div>
                            </div>
                            <div class="col-md-2 text-md-center">
                                <div class="price-tag mb-1">{{ trip.pricePerSeat }}€</div>
                                <span class="status-badge
                                    {% if trip.status == constant('App\\Enum\\TripStatus::Open') %}status-open
                                    {% elseif trip.status == constant('App\\Enum\\TripStatus::Full') %}status-full
                                    {% elseif trip.status == constant('App\\Enum\\TripStatus::Cancelled') %}status-cancelled
                                    {% else %}status-completed{% endif %}">
                                    {% if trip.status == constant('App\\Enum\\TripStatus::Open') %}Disponible
                                    {% elseif trip.status == constant('App\\Enum\\TripStatus::Full') %}Complet
                                    {% elseif trip.status == constant('App\\Enum\\TripStatus::Cancelled') %}Annulé
                                    {% else %}Terminé{% endif %}
                                </span>
                            </div>
                            <div class="col-md-3 d-flex gap-2 justify-content-md-end">
                                <a href="{{ path('app_profile_trip_show', { trip: trip.id }) }}" class="btn-action btn-action-show" title="Voir"><i class="bi bi-eye"></i></a>
                                {% if trip.status == constant('App\\Enum\\TripStatus::Open') %}
                                    <a href="{{ path('app_profile_trip_form', { trip: trip.id }) }}"
                                       class="btn-action btn-action-edit" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                {% endif %}
                                {% if trip.status != constant('App\\Enum\\TripStatus::Cancelled')
                                    and trip.status != constant('App\\Enum\\TripStatus::Completed')
                                    and trip.departureAt > date() %}
                                    <form method="post"
                                          action="{{ path('app_profile_trip_cancel', { trip: trip.id }) }}"
                                          onsubmit="return confirm('Annuler ce trajet ?')"
                                          style="display:contents;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_trip_' ~ trip.id) }}">
                                        <button type="submit" class="btn-action btn-action-cancel" title="Annuler">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}