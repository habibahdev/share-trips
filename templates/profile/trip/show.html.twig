{% extends 'base.html.twig' %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <a href="{{ path('app_home') }}" class="text-decoration-none text-muted small">
                            ⬅️ Retour accueil
                        </a>
                        <h1 class="h3 fw-bold mt-1 mb-0">
                            {{ trip.origin }} <i class="ri-arrow-right-long-fill me-1"></i> {{ trip.destination }}
                        </h1>
                    </div>
                    <span class="badge rounded-pill px-3 py-2 fs-6
                        {% if trip.status.value == 'open' %}bg-success
                        {% elseif trip.status.value == 'full' %}bg-warning text-dark
                        {% elseif trip.status.value == 'cancelled' %}bg-danger
                        {% else %}bg-secondary{% endif %}">
                        {% if trip.status.value == 'open' %}Disponible
                        {% elseif trip.status.value == 'full' %}Complet
                        {% elseif trip.status.value == 'cancelled' %}Annulé
                        {% else %}Terminé{% endif %}
                    </span>
                </div>


                <div class="row g-4">
                
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-4">Informations du trajet</h5>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="text-muted small fw-semibold text-uppercase">Départ</label>
                                        <p class="fw-medium mb-0">{{ trip.origin }}</p>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="text-muted small fw-semibold text-uppercase">Arrivée</label>
                                        <p class="fw-medium mb-0">{{ trip.destination }}</p>
                                    </div>
                                    <div class="col-12"><hr class="my-1"></div>
                                    <div class="col-md-6">
                                        <label class="text-muted small fw-semibold text-uppercase">Date de départ</label>
                                        <p class="fw-medium mb-0">{{ trip.departureAt|date('d/m/Y à H:i') }}</p>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="text-muted small fw-semibold text-uppercase">Places disponibles</label>
                                        <p class="fw-medium mb-0">
                                            <span class="badge rounded-pill px-3"
                                                style="background: linear-gradient(135deg, #ecfdf5, #e0f2fe); color: #059669;">
                                                {{ trip.availableSeats }} place{{ trip.availableSeats > 1 ? 's' : '' }}
                                            </span>
                                        </p>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="text-muted small fw-semibold text-uppercase">Prix par place</label>
                                        <p class="fw-bold text-primary fs-5 mb-0">{{ trip.pricePerSeat }}€</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-4">Véhicule</h5>
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fs-4"
                                        style="width: 55px; height: 55px; background: linear-gradient(135deg, #059669, #0284c7); flex-shrink: 0;">
                                        🚗
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0">{{ trip.vehicle.brand }} {{ trip.vehicle.model }}</h6>
                                        {% if trip.vehicle.color %}
                                            <small class="text-muted">{{ trip.vehicle.color }}</small>
                                        {% endif %}
                                    </div>
                                </div>
                                <ul class="list-unstyled mb-0">
                                    <li class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="text-muted small">Immatriculation</span>
                                        <span class="fw-semibold small">{{ trip.vehicle.plate }}</span>
                                    </li>
                                    <li class="d-flex justify-content-between py-2">
                                        <span class="text-muted small">Nombre de places</span>
                                        <span class="fw-semibold small">{{ trip.vehicle.seats }}</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>




                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-4">
                                    Passagers
                                    <span class="badge bg-secondary rounded-pill ms-1">
                                        {{ trip.bookings|length }}
                                    </span>
                                </h5>

                                {% if trip.bookings is empty %}
                                    <div class="text-center text-muted py-3">
                                        <div class="fs-3 mb-2">👥</div>
                                        <p class="small mb-0">Aucune réservation pour l'instant.</p>
                                    </div>
                                {% else %}
                                    <ul class="list-unstyled mb-0">
                                        {% for booking in trip.bookings %}
                                            {% if booking.status.value != 'cancelled' %}
                                                <li class="d-flex justify-content-between align-items-center py-2
                                                    {% if not loop.last %}border-bottom{% endif %}">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                                            style="width: 35px; height: 35px; font-size: 0.85rem; background: linear-gradient(135deg, #059669, #0284c7); flex-shrink: 0;">
                                                            {{ booking.passenger.firstName ? booking.passenger.firstName|first|upper : '?' }}
                                                        </div>
                                                        <div>
                                                            <div class="fw-medium small">
                                                                {{ booking.passenger.firstName ?? 'Utilisateur' }}
                                                                {{ booking.passenger.lastName ?? '' }}
                                                            </div>
                                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                                {{ booking.seatsBooked }} place{{ booking.seatsBooked > 1 ? 's' : '' }}
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <span class="badge rounded-pill px-2
                                                        {% if booking.status.value == 'confirmed' %}bg-success
                                                        {% else %}bg-warning text-dark{% endif %}">
                                                        {% if booking.status.value == 'confirmed' %}Confirmée
                                                        {% else %}En attente{% endif %}
                                                    </span>
                                                </li>
                                            {% endif %}
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        </div>
                    </div>


                    {% if trip.status.value != 'cancelled' and trip.status.value != 'completed' %}
                        <div class="col-12">
                            <div class="card border-0 shadow-sm rounded-4">
                                <div class="card-body p-4 d-flex gap-3">
                                    <a href="{{ path('app_profile_trip_form', {id: trip.id}) }}"
                                    class="btn btn-primary rounded-pill px-4">
                                        ✍️ Modifier le trajet
                                    </a>
                                    ❌ Annuler le trajet
                                </div>
                            </div>
                        </div>
                    {% endif %}

                </div>
            </div>
        </div>
    </div>
{% endblock %}