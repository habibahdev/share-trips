{% extends 'base.html.twig' %}

{% block title %}{{ trip.origin }} → {{ trip.destination }} | Share Trips{% endblock %}

{% block body %}
<div class="trip-show-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <a href="{{ path('app_profile_trip') }}" class="back-link mb-2 d-inline-flex"><i class="bi bi-arrow-left"></i> Mes trajets</a>
                        <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:.25rem 0 0;">
                            <i class="bi bi-geo-alt-fill me-1" style="color:#1d4ed8;font-size:1.1rem;"></i>{{ trip.origin }}
                            <i class="bi bi-arrow-right mx-2 text-muted" style="font-size:1rem;"></i>
                            <i class="bi bi-geo-fill me-1" style="color:#1e3a5f;font-size:1.1rem;"></i>{{ trip.destination }}
                        </h1>
                    </div>
                    <span class="status-badge {% if trip.status.value == 'open' %}status-open{% elseif trip.status.value == 'full' %}status-full{% elseif trip.status.value == 'cancelled' %}status-cancelled{% else %}status-completed{% endif %}">
                        {% if trip.status.value == 'open' %}Disponible{% elseif trip.status.value == 'full' %}Complet{% elseif trip.status.value == 'cancelled' %}Annulé{% else %}Terminé{% endif %}
                    </span>
                </div>

                <div class="row g-4">

                    <div class="col-12">
                        <div class="show-card">
                            <div class="card-section-title"><i class="bi bi-info-circle"></i> Informations du trajet</div>
                            <div class="row g-4">
                                <div class="col-md-6"><div class="info-label">Départ</div><p class="info-value">{{ trip.origin }}</p></div>
                                <div class="col-md-6"><div class="info-label">Arrivée</div><p class="info-value">{{ trip.destination }}</p></div>
                                <div class="col-12"><hr class="divider" style="margin:.25rem 0;"></div>
                                <div class="col-md-4"><div class="info-label">Date</div><p class="info-value">{{ trip.departureAt|date('d/m/Y à H:i') }}</p></div>
                                <div class="col-md-4">
                                    <div class="info-label">Places disponibles</div>
                                    <span class="seats-badge"><i class="bi bi-person-check me-1"></i>{{ trip.availableSeats }} place{{ trip.availableSeats > 1 ? 's' : '' }}</span>
                                </div>
                                <div class="col-md-4"><div class="info-label">Prix par place</div><span class="price-tag">{{ trip.pricePerSeat }}€</span></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="show-card h-100">
                            <div class="card-section-title"><i class="bi bi-car-front"></i> Véhicule</div>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="vehicle-avatar"><i class="bi bi-car-front" style="color:#1d4ed8;"></i></div>
                                <div>
                                    <div style="font-weight:700;color:#1e3a5f;font-size:.95rem;">{{ trip.vehicle.brand }} {{ trip.vehicle.model }}</div>
                                    {% if trip.vehicle.color %}<div style="font-size:.8rem;color:#94a3b8;">{{ trip.vehicle.color }}</div>{% endif %}
                                </div>
                            </div>
                            <div class="vehicle-row"><span class="vehicle-row-label">Immatriculation</span><span class="vehicle-row-value">{{ trip.vehicle.plate }}</span></div>
                            <div class="vehicle-row"><span class="vehicle-row-label">Nombre de places</span><span class="vehicle-row-value">{{ trip.vehicle.seats }}</span></div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="show-card h-100">
                            <div class="card-section-title">
                                <i class="bi bi-people"></i> Passagers
                                <span style="background:#f1f5f9;color:#475569;font-size:.7rem;font-weight:700;border-radius:20px;padding:.15rem .6rem;">{{ trip.bookings|length }}</span>
                            </div>
                            {% if trip.bookings is empty %}
                                <div class="text-center py-4">
                                    <i class="bi bi-people d-block mb-2" style="font-size:2rem;color:#bfdbfe;"></i>
                                    <p style="font-size:.85rem;color:#94a3b8;margin:0;">Aucune réservation pour l'instant.</p>
                                </div>
                            {% else %}
                                <div class="d-flex flex-column gap-2">
                                    {% for booking in trip.bookings %}
                                        {% if booking.status.value != 'cancelled' %}
                                            <div class="d-flex justify-content-between align-items-center py-2 {% if not loop.last %}border-bottom{% endif %}" style="border-color:#f8fafc !important;">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="passenger-avatar">{{ booking.passenger.firstName ? booking.passenger.firstName|first|upper : '?' }}</div>
                                                    <div>
                                                        <div style="font-size:.875rem;font-weight:600;color:#1e3a5f;">{{ booking.passenger.firstName ?? 'Utilisateur' }} {{ booking.passenger.lastName ?? '' }}</div>
                                                        <div style="font-size:.75rem;color:#94a3b8;">{{ booking.seatsBooked }} place{{ booking.seatsBooked > 1 ? 's' : '' }}</div>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="booking-status {% if booking.status.value == 'confirmed' %}booking-confirmed{% else %}booking-pending{% endif %}">
                                                        {% if booking.status.value == 'confirmed' %}Confirmée{% else %}En attente{% endif %}
                                                    </span>
                                                    {% if booking.status.value == 'pending' %}
                                                        <form action="{{ path('app_profile_trip_booking_confirm', { booking: booking.id }) }}" method="post">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('confirm_' ~ booking.id) }}">
                                                            <button type="submit" style="background:#dcfce7;color:#166534;border:none;border-radius:8px;padding:.25rem .7rem;font-size:.72rem;font-weight:700;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;">
                                                                <i class="bi bi-check2"></i> Confirmer
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {% if trip.status.value != 'cancelled' and trip.status.value != 'completed' %}
                        <div class="col-12">
                            <div class="show-card d-flex gap-3 flex-wrap">
                                <a href="{{ path('app_profile_trip_form', { trip: trip.id }) }}" class="btn-edit">
                                    <i class="bi bi-pencil"></i> Modifier le trajet
                                </a>
                                <form method="post" action="{{ path('app_profile_trip_cancel', { trip: trip.id }) }}" onsubmit="return confirm('Annuler ce trajet ?')" style="display:contents;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_trip_' ~ trip.id) }}">
                                    <button type="submit" class="btn-cancel-trip"><i class="bi bi-x-lg"></i> Annuler le trajet</button>
                                </form>
                            </div>
                        </div>
                    {% endif %}

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}