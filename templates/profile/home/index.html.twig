{% extends 'base.html.twig' %}

{% block title %}Mon profil - Share Trips{% endblock %}

{% block body %}
<div class="profile-page">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:0;">Mon profil</h1>
                <p class="text-muted mb-0" style="font-size:.9rem;">Gérez vos informations personnelles</p>
            </div>
            <a href="{{ path('app_profile_info') }}" class="btn-edit">
                <i class="bi bi-pencil"></i> Modifier
            </a>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="profile-card p-4 text-center h-100">

                    <div class="avatar-lg">
                        {{ user.firstName ? user.firstName|first|upper : '?' }}{{ user.lastName ? user.lastName|first|upper : '' }}
                    </div>

                    <h4 style="font-weight:800;color:#1e3a5f;margin-bottom:.25rem;">
                        {{ user.firstName ?? '' }} {{ user.lastName ?? '' }}
                    </h4>
                    <p style="color:#94a3b8;font-size:.875rem;margin-bottom:1rem;">
                        {{ user.email }}
                    </p>

                    <span class="member-badge">
                        <i class="bi bi-calendar3"></i>
                        Membre depuis {{ user.createdAt|date('d/m/Y') }}
                    </span>

                </div>
            </div>

            <div class="col-lg-8">
                <div class="profile-card p-4 h-100">

                    <div class="section-title">
                        <i class="bi bi-person me-1"></i> Informations personnelles
                    </div>

                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="info-label">Prénom</div>
                            <p class="info-value {{ not user.firstName ? 'empty' : '' }}">
                                {{ user.firstName ?? 'Non renseigné' }}
                            </p>
                        </div>
                        <div class="col-sm-6">
                            <div class="info-label">Nom</div>
                            <p class="info-value {{ not user.lastName ? 'empty' : '' }}">
                                {{ user.lastName ?? 'Non renseigné' }}
                            </p>
                        </div>

                        <div class="col-12" style="border-top:1.5px solid #f1f5f9;margin:0 .75rem;padding-top:1rem;"></div>

                        <div class="col-sm-6">
                            <div class="info-label">Email</div>
                            <p class="info-value">{{ user.email }}</p>
                        </div>
                        <div class="col-sm-6">
                            <div class="info-label">Téléphone</div>
                            <p class="info-value {{ not user.phone ? 'empty' : '' }}">
                                {{ user.phone ?? 'Non renseigné' }}
                            </p>
                        </div>
                    </div>

                </div>
            </div>

            <div class="col-12">
                <div class="profile-card p-4">

                    <div class="section-title">
                        <i class="bi bi-grid me-1"></i> Accès rapides
                    </div>

                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <a href="{{ path('app_profile_vehicle') }}" class="quick-link">
                                <div class="quick-link-icon" style="background:#eff6ff;">
                                    <i class="bi bi-car-front" style="color:#1d4ed8;"></i>
                                </div>
                                <div class="quick-link-label">Mes véhicules</div>
                                <div class="quick-link-sub">
                                    {{ user.vehicles|length }} véhicule{{ user.vehicles|length > 1 ? 's' : '' }}
                                </div>
                            </a>
                        </div>

                        <div class="col-6 col-md-3">
                            <a href="{{ path('app_profile_booking') }}" class="quick-link">
                                <div class="quick-link-icon" style="background:#eff6ff;">
                                    <i class="bi bi-ticket-perforated" style="color:#1d4ed8;"></i>
                                </div>
                                <div class="quick-link-label">Mes réservations</div>
                                <div class="quick-link-sub">
                                    {{ user.bookings|length }} réservation{{ user.bookings|length > 1 ? 's' : '' }}
                                </div>
                            </a>
                        </div>

                        <div class="col-6 col-md-3">
                            <a href="{{ path('app_profile_trip') }}" class="quick-link">
                                <div class="quick-link-icon" style="background:#eff6ff;">
                                    <i class="bi bi-map" style="color:#1d4ed8;"></i>
                                </div>
                                <div class="quick-link-label">Mes trajets</div>
                                <div class="quick-link-sub">Gérer mes trajets</div>
                            </a>
                        </div>

                        <div class="col-6 col-md-3">
                            <a href="{{ path('app_profile_password') }}" class="quick-link">
                                <div class="quick-link-icon" style="background:#eff6ff;">
                                    <i class="bi bi-lock" style="color:#1d4ed8;"></i>
                                </div>
                                <div class="quick-link-label">Mot de passe</div>
                                <div class="quick-link-sub">Modifier</div>
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
