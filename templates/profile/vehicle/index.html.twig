{% extends 'base.html.twig' %}

{% block body %}
<div class="vehicles-page">
    <div class="container">

        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <a href="{{ path('app_profile') }}" class="back-link mb-2 d-inline-flex">
                    <i class="bi bi-arrow-left"></i> Mon profil
                </a>
                <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:.25rem 0 .2rem;">Mes véhicules</h1>
                <p style="font-size:.85rem;color:#94a3b8;margin:0;">Gérez vos véhicules pour proposer des trajets</p>
            </div>
            <a href="{{ path('app_profile_vehicle_form') }}" class="btn-new mt-1">
                <i class="bi bi-plus-lg"></i> Ajouter un véhicule
            </a>
        </div>

        {% if vehicles is empty %}
            <div class="empty-card">
                <i class="bi bi-car-front d-block mb-3" style="font-size:3rem;color:#bfdbfe;"></i>
                <h5 style="font-weight:800;color:#1e3a5f;margin-bottom:.5rem;">Aucun véhicule enregistré</h5>
                <p class="text-muted mb-4" style="font-size:.9rem;">Ajoutez un véhicule pour pouvoir proposer des trajets.</p>
                <a href="{{ path('app_profile_vehicle_form') }}" class="btn-new">
                    <i class="bi bi-plus-lg"></i> Ajouter un véhicule
                </a>
            </div>
        {% else %}
            <div class="row g-4">
                {% for vehicle in vehicles %}
                    <div class="col-md-6 col-lg-4">
                        <div class="vehicle-card">

                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="vehicle-icon">
                                    <i class="bi bi-car-front" style="color:#1d4ed8;"></i>
                                </div>
                                <div>
                                    <p class="vehicle-name">{{ vehicle.brand }} {{ vehicle.model }}</p>
                                    {% if vehicle.color %}
                                        <span class="vehicle-color">{{ vehicle.color }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="vehicle-row">
                                    <span class="vehicle-row-label">Immatriculation</span>
                                    <span class="vehicle-row-value">{{ vehicle.plate }}</span>
                                </div>
                                <div class="vehicle-row">
                                    <span class="vehicle-row-label">Nombre de places</span>
                                    <span class="seats-badge">
                                        <i class="bi bi-person-check me-1"></i>{{ vehicle.seats }} places
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a href="{{ path('app_profile_vehicle_form', { vehicle: vehicle }) }}"
                                   class="btn-action btn-action-edit">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                                <a href="{{ path('app_profile_vehicle_delete', { vehicle: vehicle }) }}"
                                   class="btn-action btn-action-delete">
                                    <i class="bi bi-trash2"></i> Supprimer
                                </a>
                            </div>

                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
