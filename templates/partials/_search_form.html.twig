<div class="search-card">
    <form method="get" action="{{ path('app_trips') }}">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <div class="search-label">
                    <i class="bi bi-geo-alt-fill me-1" style="color:#1d4ed8;"></i>Départ
                </div>
                <div class="autocomplete-wrapper position-relative">
                    <input type="text"
                           name="origin"
                           id="search_origin"
                           class="search-input form-control"
                           placeholder="Ville de départ"
                           value="{{ origin ?? '' }}">
                </div>
            </div>
            <div class="col-md-auto d-none d-md-flex align-items-center justify-content-center" style="padding-bottom:.5rem;">
                <i class="bi bi-arrow-right" style="color:#cbd5e1;font-size:1.2rem;margin-top:1.5rem;"></i>
            </div>
            <div class="col-md-3">
                <div class="search-label">
                    <i class="bi bi-geo-fill me-1" style="color:#1e3a5f;"></i>Arrivée
                </div>
                <div class="autocomplete-wrapper position-relative">
                    <input type="text"
                           name="destination"
                           id="search_destination"
                           class="search-input form-control"
                           placeholder="Ville d'arrivée"
                           value="{{ destination ?? '' }}">
                </div>
            </div>
            <div class="col-md-3">
                <div class="search-label">
                    <i class="bi bi-calendar3 me-1 text-secondary"></i>Date
                </div>
                <input type="date"
                       name="date"
                       class="search-input form-control"
                       value="{{ date ?? '' }}">
            </div>
            <div class="col-md-2">
                <div class="search-label" style="opacity:0;">_</div>
                <button type="submit" class="btn-search w-100">
                    <i class="bi bi-search me-2"></i>Rechercher
                </button>
            </div>
        </div>
    </form>
</div>