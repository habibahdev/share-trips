{% extends 'emails/_layout.html.twig' %}

{% set title = 'Compte banni' %}

{% block content %}

    <p style="color:#475569;">
        Bonjour <strong>{{ user.firstName }}</strong>,
        votre compte a été définitivement banni de ShareTrips.
    </p>

    {% if user.adminNote %}
    <div style="background:#fee2e2;border:1.5px solid #fecaca;border-radius:12px;padding:1rem;margin:1rem 0;">
        <p style="color:#991b1b;margin:0;">Motif : {{ user.adminNote }}</p>
    </div>
    {% endif %}

    <p style="color:#475569;">Si vous pensez que c'est une erreur, contactez notre support.</p>

{% endblock %}