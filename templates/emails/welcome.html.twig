<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="font-family:'Plus Jakarta Sans',sans-serif;background:#f8fafc;padding:2rem;">
    <div style="max-width:600px;margin:0 auto;background:#fff;border-radius:20px;border:1.5px solid #f1f5f9;padding:2rem;">

        <div style="text-align:center;margin-bottom:2rem;">
            <h1 style="color:#1e3a5f;font-size:1.5rem;font-weight:800;">
                Share<span style="color:#1d4ed8;">Trips</span>
            </h1>
        </div>

        <h2 style="color:#1e3a5f;font-weight:700;">Bienvenue {{ user.firstName }} ! 👋</h2>
        <p style="color:#475569;">Pour terminer votre inscription, vous devez confirmer votre adresse e-mail en cliquant sur le lien ci-dessous</p>


        <div style="text-align:center;margin:2rem 0;">
            <a href="{{ absolute_url(path('app_confirm_email', { token: token, id: user.id } )) }}"
            style="background:#1e3a5f;color:#fff;border-radius:12px;padding:.85rem 2rem;font-weight:700;text-decoration:none;">
                Confirmer mon adresse e-mail
            </a>
        </div>

        <p style="color:#475569;">Lien valable jusqu'au {{ lifetimeToken }}</p>

        <p style="color:#94a3b8;font-size:.8rem;text-align:center;">
            © {{ "now"|date("Y") }} ShareTrips - Tous droits réservés
        </p>
    </div>
</body>
</html>