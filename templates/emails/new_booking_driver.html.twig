{% extends 'emails/_layout.html.twig' %}

{% set icon     = '🔔' %}
{% set icon_bg  = '#fef9c3' %}
{% set title    = 'Nouvelle demande de réservation 🎉' %}
{% set subtitle %}
    Bonjour <strong>{{ booking.trip.driver.firstName }}</strong>,
    <strong>{{ booking.passenger.firstName }} {{ booking.passenger.lastName }}</strong>
    souhaite réserver une place sur votre trajet.
{% endset %}

{% block content %}

    {{ include('emails/_trip_details.html.twig', { booking: booking, show_payment: false }) }}

    <div style="background:#dcfce7;border:1.5px solid #bbf7d0;border-radius:12px;padding:1rem 1.25rem;margin-bottom:1.5rem;color:#166534;font-size:.875rem;text-align:center;">
        ✅ <strong>Paiement Stripe encaissé</strong> —
        {{ booking.totalPrice|number_format(2, ',', ' ') }}€ ont été débités au passager.
    </div>

    <div style="text-align:center;margin:1.5rem 0;">
        <a href="{{ absolute_url(path('app_profile_trip_show', { trip: booking.trip.id })) }}"
           style="background:#1e3a5f;color:#fff;border-radius:12px;padding:.85rem 2rem;font-weight:700;text-decoration:none;display:inline-block;">
            Voir la demande et confirmer
        </a>
    </div>

{% endblock %}