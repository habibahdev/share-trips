<!DOCTYPE html>
<html lang="fr">
<body style="font-family:'Plus Jakarta Sans',sans-serif;background:#f8fafc;padding:2rem;margin:0;">
<div style="max-width:600px;margin:0 auto;background:#fff;border-radius:20px;border:1.5px solid #f1f5f9;padding:2rem;box-shadow:0 8px 24px rgba(30,58,95,.06);">
    <div style="text-align:center;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1.5px solid #f1f5f9;">
        <h1 style="color:#1e3a5f;font-size:1.5rem;font-weight:800;margin:0;">
            Share<span style="color:#1d4ed8;">Trips</span>
        </h1>
    </div>

    {% if icon is defined %}
    <div style="text-align:center;margin-bottom:1.5rem;">
        <div style="width:64px;height:64px;border-radius:50%;background:{{ icon_bg|default('#eff6ff') }};display:inline-flex;align-items:center;justify-content:center;font-size:1.5rem;">
            {{ icon }}
        </div>
    </div>
    {% endif %}

    {% if title is defined %}
    <h2 style="color:#1e3a5f;font-weight:700;text-align:center;margin-bottom:.5rem;">
        {{ title }}
    </h2>
    {% endif %}
    {% if subtitle is defined %}
    <p style="color:#475569;text-align:center;margin-bottom:1.5rem;">
        {{ subtitle }}
    </p>
    {% endif %}

    {% block content %}{% endblock %}

    <p style="color:#94a3b8;font-size:.8rem;text-align:center;margin-top:2rem;padding-top:1.5rem;border-top:1.5px solid #f1f5f9;">
        &copy; {{ "now"|date("Y") }} ShareTrips - Tous droits réservés<br>
        <span style="font-size:.75rem;">Vous recevez cet email car vous avez un compte ShareTrips.</span>
    </p>

</div>
</body>
</html>