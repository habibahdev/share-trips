{% macro trip_details(booking, show_payment) %}
<div style="background:#eff6ff;border-radius:12px;padding:1.25rem;margin:1.5rem 0;">
    <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#94a3b8;margin-bottom:.75rem;">
        Détails du trajet
    </div>
    <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;">
        <span style="color:#94a3b8;font-size:.875rem;">Trajet</span>
        <span style="color:#1e3a5f;font-weight:600;font-size:.875rem;">
            {{ booking.trip.origin }} → {{ booking.trip.destination }}
        </span>
    </div>
    <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;">
        <span style="color:#94a3b8;font-size:.875rem;">Date</span>
        <span style="color:#1e3a5f;font-weight:600;font-size:.875rem;">
            {{ booking.trip.departureAt|date('d/m/Y à H:i') }}
        </span>
    </div>
    <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;">
        <span style="color:#94a3b8;font-size:.875rem;">Places réservées</span>
        <span style="color:#1e3a5f;font-weight:600;font-size:.875rem;">
            {{ booking.seatsBooked }} place{{ booking.seatsBooked > 1 ? 's' : '' }}
        </span>
    </div>
    {% if show_payment %}
    <div style="display:flex;justify-content:space-between;padding-top:.75rem;margin-top:.75rem;border-top:1.5px solid #dbeafe;">
        <span style="color:#1e3a5f;font-weight:700;font-size:.875rem;">Total</span>
        <span style="color:#1d4ed8;font-weight:800;font-size:.95rem;">{{ booking.totalPrice }}€</span>
    </div>
    {% endif %}
</div>
{% endmacro %}