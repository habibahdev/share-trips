{% extends 'emails/_layout.html.twig' %}

{% set icon     = '↩' %}
{% set icon_bg  = '#dcfce7' %}
{% set title    = 'Remboursement en cours' %}
{% set subtitle %}
    Bonjour <strong>{{ booking.passenger.firstName }}</strong>,
    suite à l'annulation du trajet
    <strong>{{ booking.trip.origin }} → {{ booking.trip.destination }}</strong>,
    votre remboursement est en cours.
{% endset %}

{% block content %}

    <div style="background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:12px;padding:1.25rem;text-align:center;margin-bottom:1.5rem;">
        <div style="font-size:2rem;font-weight:800;color:#166534;">
            {{ booking.totalPrice|number_format(2, ',', ' ') }}€
        </div>
        <div style="font-size:.85rem;color:#22c55e;margin-top:.25rem;">Montant remboursé</div>
    </div>

    {{ include('emails/_trip_details.html.twig', { booking: booking, show_payment: false, bg: '#f1f5f9' }) }}

    <div style="text-align:center;margin-bottom:1rem;">
        <span style="display:inline-flex;align-items:center;gap:.4rem;background:#f5f3ff;border:1px solid #e0e7ff;border-radius:8px;padding:.4rem .9rem;font-size:.78rem;font-weight:700;color:#635BFF;">
            🔒 Remboursement traité par Stripe
        </span>
    </div>

    <div style="background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:12px;padding:1rem 1.25rem;color:#166534;font-size:.875rem;text-align:center;">
        Le remboursement sera effectué sous <strong>5 à 10 jours ouvrés</strong> selon votre banque.
    </div>

{% endblock %}