{% extends 'emails/_layout.html.twig' %}

{% set icon     = '✕' %}
{% set icon_bg  = '#fee2e2' %}
{% set title    = 'Réservation annulée' %}
{% set subtitle %}
    Bonjour <strong>{{ booking.trip.driver.firstName }}</strong>,
    le passager <strong>{{ booking.passenger.fullName }}</strong> a annulé sa réservation.
{% endset %}

{% block content %}

    {{ include('emails/_trip_details.html.twig', { booking: booking, show_payment: false, bg: '#f1f5f9' }) }}

    <div style="background:#fefce8;border:1.5px solid #fde68a;border-radius:12px;padding:1rem 1.25rem;color:#854d0e;font-size:.875rem;text-align:center;">
        Des places sont à nouveau disponibles sur votre trajet. De nouveaux passagers peuvent réserver.
    </div>

{% endblock %}