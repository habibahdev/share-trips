<!DOCTYPE html>
<html>
<body style="font-family:'Plus Jakarta Sans',sans-serif;background:#f8fafc;padding:2rem;">
<div style="max-width:600px;margin:0 auto;background:#fff;border-radius:20px;border:1.5px solid #f1f5f9;padding:2rem;">

    <div style="text-align:center;margin-bottom:2rem;">
        <h1 style="color:#1e3a5f;font-size:1.5rem;font-weight:800;">
            Share<span style="color:#1d4ed8;">Trips</span>
        </h1>
    </div>

    <h2 style="color:#854d0e;font-weight:700;">Compte suspendu</h2>
    <p style="color:#475569;">Bonjour {{ user.firstName }}, votre compte a été suspendu temporairement.</p>

    {% if user.suspendedUntil %}
        <div style="background:#fef9c3;border:1.5px solid #fde68a;border-radius:12px;padding:1rem;margin:1rem 0;">
            <p style="color:#854d0e;margin:0;font-weight:600;">
                Suspension jusqu'au : {{ user.suspendedUntil|date('d/m/Y à H:i') }}
            </p>
        </div>
    {% endif %}

    {% if user.adminNote %}
        <p style="color:#475569;">Motif : {{ user.adminNote }}</p>
    {% endif %}

    <p style="color:#475569;">Si vous pensez que c'est une erreur, contactez notre support.</p>

    <p style="color:#94a3b8;font-size:.8rem;text-align:center;">
        © {{ "now"|date("Y") }} ShareTrips - Tous droits réservés
    </p>
</div>
</body>
</html>