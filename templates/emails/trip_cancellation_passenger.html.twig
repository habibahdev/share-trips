{% extends 'emails/_layout.html.twig' %}

{% set icon     = '⚠' %}
{% set icon_bg  = '#fee2e2' %}
{% set title    = 'Trajet annulé' %}
{% set subtitle %}
    Bonjour <strong>{{ booking.passenger.firstName }}</strong>,
    le conducteur <strong>{{ booking.trip.driver.fullName }}</strong> a annulé le trajet.
{% endset %}

{% block content %}

    {{ include('emails/_trip_details.html.twig', { booking: booking, show_payment: true, bg: '#f1f5f9' }) }}

    <div style="background:#fee2e2;border:1.5px solid #fecaca;border-radius:12px;padding:1rem 1.25rem;margin-bottom:1.5rem;color:#991b1b;font-size:.875rem;text-align:center;">
        Votre réservation a été annulée automatiquement.
        {% if booking.payment and booking.payment.isSuccessful() %}
            Un remboursement de <strong>{{ booking.totalPrice|number_format(2, ',', ' ') }}€</strong> va être initié.
        {% endif %}
    </div>

    <div style="text-align:center;margin-bottom:1.5rem;">
        <a href="{{ absolute_url(path('app_trips')) }}"
           style="background:#1d4ed8;color:#fff;border-radius:12px;padding:.85rem 2rem;font-weight:700;text-decoration:none;display:inline-block;">
            Rechercher un autre trajet
        </a>
    </div>

{% endblock %}