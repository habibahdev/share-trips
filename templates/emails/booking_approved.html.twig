{% extends 'emails/_layout.html.twig' %}

{% set icon     = '✓' %}
{% set icon_bg  = '#dcfce7' %}
{% set title    = 'Réservation confirmée !' %}
{% set subtitle %}
    Bonjour <strong>{{ booking.passenger.firstName }}</strong>,
    votre place a été confirmée par le conducteur.
{% endset %}

{% block content %}

    {{ include('emails/_trip_details.html.twig', { booking: booking, show_payment: true }) }}

    <div style="background:#f8fafc;border-radius:12px;padding:1.25rem;margin-bottom:1.5rem;">
        <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#94a3b8;margin-bottom:.75rem;">
            Votre conducteur
        </div>
        <div style="display:flex;align-items:center;gap:.75rem;">
            <div style="width:40px;height:40px;border-radius:50%;background:#dbeafe;display:inline-flex;align-items:center;justify-content:center;font-weight:800;color:#1d4ed8;">
                {{ booking.trip.driver.firstName|first|upper }}
            </div>
            <div>
                <div style="font-weight:600;color:#1e3a5f;font-size:.9rem;">
                    {{ booking.trip.driver.fullName }}
                </div>
                <div style="font-size:.78rem;color:#94a3b8;">
                    {{ booking.trip.vehicle.brand }} {{ booking.trip.vehicle.model }}
                </div>
            </div>
        </div>
    </div>

    <div style="background:#dcfce7;border-radius:12px;padding:1rem 1.25rem;color:#166534;font-size:.875rem;text-align:center;">
        ✅ <strong>Tout est prêt !</strong> Rendez-vous au point de départ
        le {{ booking.trip.departureAt|date('d/m/Y à H:i') }}.
    </div>

{% endblock %}