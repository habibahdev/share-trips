<!DOCTYPE html>
<html>
<body style="font-family:'Plus Jakarta Sans',sans-serif;background:#f8fafc;padding:2rem;">
<div style="max-width:600px;margin:0 auto;background:#fff;border-radius:20px;border:1.5px solid #f1f5f9;padding:2rem;">

    <div style="text-align:center;margin-bottom:2rem;">
        <h1 style="color:#1e3a5f;font-size:1.5rem;font-weight:800;">
            Share<span style="color:#1d4ed8;">Trips</span>
        </h1>
    </div>

    <h2 style="color:#1e3a5f;font-weight:700;">Réservation enregistrée !</h2>
    <p style="color:#475569;">Bonjour {{ booking.passenger.firstName }}, votre réservation est bien enregistrée et en attente de confirmation.</p>

    <div style="background:#eff6ff;border-radius:12px;padding:1.25rem;margin:1.5rem 0;">
        <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;">
            <span style="color:#94a3b8;font-size:.875rem;">Trajet</span>
            <span style="color:#1e3a5f;font-weight:600;font-size:.875rem;">{{ booking.trip.origin }} → {{ booking.trip.destination }}</span>
        </div>
        <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;">
            <span style="color:#94a3b8;font-size:.875rem;">Date</span>
            <span style="color:#1e3a5f;font-weight:600;font-size:.875rem;">{{ booking.trip.departureAt|date('d/m/Y à H:i') }}</span>
        </div>
        <div style="display:flex;justify-content:space-between;margin-bottom:.5rem;">
            <span style="color:#94a3b8;font-size:.875rem;">Places</span>
            <span style="color:#1e3a5f;font-weight:600;font-size:.875rem;">{{ booking.seatsBooked }}</span>
        </div>
        <div style="display:flex;justify-content:space-between;border-top:1.5px solid #dbeafe;padding-top:.5rem;margin-top:.5rem;">
            <span style="color:#1e3a5f;font-weight:700;">Total</span>
            <span style="color:#1e3a5f;font-weight:800;">{{ booking.totalPrice }}€</span>
        </div>
    </div>

    <p style="color:#94a3b8;font-size:.8rem;text-align:center;">
        © {{ "now"|date("Y") }} ShareTrips — Tous droits réservés
    </p>
</div>
</body>
</html>