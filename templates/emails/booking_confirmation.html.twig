{% extends 'emails/_layout.html.twig' %}

{% set icon     = '💳' %}
{% set icon_bg  = '#eff6ff' %}
{% set title    = 'Paiement reçu !' %}
{% set subtitle %}
    Bonjour <strong>{{ booking.passenger.firstName }}</strong>,
    votre paiement a bien été encaissé. Le conducteur va confirmer votre place.
{% endset %}

{% block content %}

    {{ include('emails/_trip_details.html.twig', { booking: booking, show_payment: true }) }}

    <div style="text-align:center;margin-bottom:1.5rem;">
        <span style="display:inline-flex;align-items:center;gap:.4rem;background:#f5f3ff;border:1px solid #e0e7ff;border-radius:8px;padding:.4rem .9rem;font-size:.78rem;font-weight:700;color:#635BFF;">
            🔒 Paiement sécurisé par Stripe
        </span>
    </div>

    <div style="background:#fefce8;border:1.5px solid #fef08a;border-radius:12px;padding:1rem 1.25rem;color:#854d0e;font-size:.875rem;text-align:center;">
        ⏳ <strong>En attente de confirmation</strong> — Le conducteur doit valider votre place.
        Vous recevrez un email dès qu'il aura confirmé.
    </div>

{% endblock %}