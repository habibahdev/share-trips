{% extends 'base.html.twig' %}

{% block title %}{{ trip.origin }} → {{ trip.destination }} - Share Trips{% endblock %}

{% block body %}
<div class="trip-show-page">
    <div class="container">

        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <a href="{{ path('app_trips') }}" class="back-link mb-2 d-inline-flex">
                    <i class="bi bi-arrow-left"></i> Tous les trajets
                </a>
                <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:.25rem 0 0;">
                    <i class="bi bi-geo-alt-fill me-1" style="color:#1d4ed8;font-size:1.1rem;"></i>
                    {{ trip.origin }}
                    <i class="bi bi-arrow-right mx-2 text-muted" style="font-size:1rem;"></i>
                    <i class="bi bi-geo-fill me-1" style="color:#1e3a5f;font-size:1.1rem;"></i>
                    {{ trip.destination }}
                </h1>
            </div>
            <span class="status-badge
                {% if trip.status == constant('App\\Enum\\TripStatus::Open') %}status-open
                {% elseif trip.status == constant('App\\Enum\\TripStatus::Full') %}status-full
                {% elseif trip.status == constant('App\\Enum\\TripStatus::Cancelled') %}status-cancelled
                {% else %}status-completed{% endif %}">
                {% if trip.status == constant('App\\Enum\\TripStatus::Open') %}Disponible
                {% elseif trip.status == constant('App\\Enum\\TripStatus::Full') %}Complet
                {% elseif trip.status == constant('App\\Enum\\TripStatus::Cancelled') %}Annulé
                {% else %}Terminé{% endif %}
            </span>
        </div>

        <div class="row g-4">

            <div class="col-lg-7">

                <div class="show-card mb-4">
                    <div class="card-section-title"><i class="bi bi-info-circle"></i> Informations</div>
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="info-label">Départ</div>
                            <p class="info-value">{{ trip.origin }}</p>
                        </div>
                        <div class="col-sm-6">
                            <div class="info-label">Arrivée</div>
                            <p class="info-value">{{ trip.destination }}</p>
                        </div>
                        <div class="col-12"><hr class="divider" style="margin:.25rem 0;"></div>
                        <div class="col-sm-4">
                            <div class="info-label">Date</div>
                            <p class="info-value">{{ trip.departureAt|date('d/m/Y') }}</p>
                        </div>
                        <div class="col-sm-4">
                            <div class="info-label">Heure</div>
                            <p class="info-value">{{ trip.departureAt|date('H:i') }}</p>
                        </div>
                        <div class="col-sm-4">
                            <div class="info-label">Places</div>
                            <span class="seats-badge">
                                <i class="bi bi-person-check"></i>
                                {% if trip.availableSeats <= 0 %}
                                    Complet
                                {% elseif trip.availableSeats <= 2 %}
                                    {{ trip.availableSeats }} (presque complet)
                                {% else %}
                                    {{ trip.availableSeats }} dispo
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>

                <div class="show-card mb-4">
                    <div class="card-section-title"><i class="bi bi-person"></i> Conducteur</div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="driver-avatar">{{ trip.driver.firstName ? trip.driver.firstName|first|upper : '?' }}</div>
                        <div>
                            <div style="font-weight:700;color:#1e3a5f;font-size:1rem;">{{ trip.driver.firstName ?? '' }} {{ trip.driver.lastName ?? '' }}</div>
                            {% if trip.driver.phone %}
                                <div style="font-size:.82rem;color:#94a3b8;margin-top:.2rem;"><i class="bi bi-telephone me-1"></i>{{ trip.driver.phone }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="show-card">
                    <div class="card-section-title"><i class="bi bi-car-front"></i> Véhicule</div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="vehicle-icon"><i class="bi bi-car-front" style="color:#1d4ed8;"></i></div>
                        <div>
                            <div style="font-weight:700;color:#1e3a5f;font-size:.95rem;">{{ trip.vehicle.brand }} {{ trip.vehicle.model }}</div>
                            {% if trip.vehicle.color %}<div style="font-size:.8rem;color:#94a3b8;">{{ trip.vehicle.color }}</div>{% endif %}
                        </div>
                    </div>
                    {#<div class="detail-row">
                        <span class="detail-row-label">Immatriculation</span>
                        <span class="detail-row-value">{{ trip.vehicle.plate }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-row-label">Nombre de places</span>
                        <span class="detail-row-value">{{ trip.vehicle.seats }}</span>
                    </div>#}
                </div>

            </div>

            <div class="col-lg-5">
                <div class="show-card" style="position:sticky;top:90px;">

                    <div class="text-center mb-4 pb-4" style="border-bottom:1.5px solid #f1f5f9;">
                        <div class="info-label mb-1">Prix par place</div>
                        <span class="price-hero">{{ trip.pricePerSeat }}€</span>
                    </div>

                    {% if trip.status == constant('App\\Enum\\TripStatus::Open') and trip.availableSeats > 0 %}
                        {% if not app.user %}
                            <div class="alert-info-st mb-3">
                                <i class="bi bi-info-circle-fill" style="color:#1d4ed8;flex-shrink:0;"></i>
                                Connectez-vous pour réserver ce trajet.
                            </div>
                            <a href="{{ path('app_login', {'_target_path': app.request.uri}) }}" class="btn-book">
                                Se connecter pour réserver
                            </a>
                        {% elseif app.user.id == trip.driver.id %}
                            <div class="alert-info-st">
                                <i class="bi bi-info-circle-fill" style="color:#1d4ed8;flex-shrink:0;"></i>
                                Vous êtes le conducteur de ce trajet.
                            </div>
                        {% elseif not app.user.verified %}
                            <div class="alert d-flex align-items-start gap-3 mb-3"
                                 style="background:#fffbeb;border:1.5px solid #fcd34d;border-radius:12px;padding:1rem 1.25rem;">
                                <i class="bi bi-envelope-exclamation-fill"
                                   style="color:#d97706;font-size:1.25rem;flex-shrink:0;margin-top:.1rem;"></i>
                                <div>
                                    <div style="font-weight:700;color:#92400e;margin-bottom:.25rem;">
                                        Compte non vérifié
                                    </div>
                                    <div style="font-size:.875rem;color:#92400e;">
                                        Confirmez votre adresse e-mail pour pouvoir réserver.
                                        <a href="{{ path('app_resend') }}"
                                           style="color:#d97706;font-weight:600;text-decoration:underline;">
                                            Renvoyer l'e-mail
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <button class="btn-book" disabled style="opacity:.6;cursor:not-allowed;">
                                <i class="bi bi-lock"></i> Réservation indisponible
                            </button>
                        {% else %}
                            <div style="background:#f8fafc;border-radius:12px;padding:1rem;margin-bottom:1.25rem;">
                                <div style="display:flex;justify-content:space-between;font-size:.85rem;color:#94a3b8;margin-bottom:.5rem;">
                                    <span>Places disponibles</span>
                                    <span>{{ trip.availableSeats }}</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;font-size:.85rem;color:#94a3b8;">
                                    <span>Prix par place</span>
                                    <span>{{ trip.pricePerSeat }}€</span>
                                </div>
                            </div>
                            {% if trip.availableSeats > 0 %}
                                <a href="{{ path('app_booking_add', { tripId: trip.id }) }}" class="btn-book">
                                    <i class="bi bi-check2-circle"></i> Réserver ce trajet
                                </a>
                            {% else %}
                                <button class="btn-book" disabled style="opacity:.6;cursor:not-allowed;">
                                    Complet
                                </button>
                            {% endif %}
                            {% if app.user and app.user.id != trip.driver.id and app.user.verified %}
                            <a href="{{ path('app_conversation_open', { tripId: trip.id }) }}"
                                class="btn w-100 mt-2"
                                style="border-radius:12px;border:1.5px solid #1d4ed8;color:#1d4ed8;font-weight:600;">
                                <i class="bi bi-chat-dots me-2"></i>Contacter le conducteur
                            </a>
                            {% endif %}
                        {% endif %}
                    {% elseif trip.availableSeats <= 0 %}
                        <div class="alert-info-st" style="background:#fef9c3;border-color:#fde68a;color:#854d0e;">
                            <i class="bi bi-exclamation-circle-fill" style="color:#d97706;flex-shrink:0;"></i>
                            Ce trajet est complet.
                        </div>
                    {% else %}
                        <div class="alert-info-st" style="background:#fee2e2;border-color:#fecaca;color:#991b1b;">
                            <i class="bi bi-x-circle-fill" style="color:#dc2626;flex-shrink:0;"></i>
                            Ce trajet n'est plus disponible.
                        </div>
                    {% endif %}
                    
                    {% if trip.stops is not empty %}
                        <div class="show-card mb-4">
                            <div class="card-section-title">
                                <i class="bi bi-signpost-split"></i> Arrêts intermédiaires
                            </div>
                            <div style="display:flex;flex-direction:column;gap:.5rem;">

                                {# Départ #}
                                <div style="display:flex;align-items:center;gap:.75rem;">
                                    <div style="width:10px;height:10px;border-radius:50%;background:#1d4ed8;flex-shrink:0;"></div>
                                    <span style="font-weight:700;color:#1e3a5f;">{{ trip.origin }}</span>
                                </div>

                                {# Ligne verticale + stops #}
                                {% for stop in trip.stops %}
                                    <div style="display:flex;align-items:center;gap:.75rem;padding-left:3px;">
                                        <div style="width:4px;height:20px;background:#e2e8f0;margin-left:3px;"></div>
                                    </div>
                                    <div style="display:flex;align-items:center;gap:.75rem;">
                                        <div style="width:10px;height:10px;border-radius:50%;background:#fff;
                                                    border:2px solid #1d4ed8;flex-shrink:0;"></div>
                                        <span style="color:#1e3a5f;">{{ stop.city }}</span>
                                        {% if stop.extraPrice %}
                                            <span style="margin-left:auto;font-size:.8rem;font-weight:700;
                                                        color:#1d4ed8;background:#eff6ff;
                                                        padding:.2rem .6rem;border-radius:8px;">
                                                +{{ stop.extraPrice }}€
                                            </span>
                                        {% endif %}
                                    </div>
                                {% endfor %}

                                <div style="display:flex;align-items:center;gap:.75rem;padding-left:3px;">
                                    <div style="width:4px;height:20px;background:#e2e8f0;margin-left:3px;"></div>
                                </div>

                                {# Arrivée #}
                                <div style="display:flex;align-items:center;gap:.75rem;">
                                    <div style="width:10px;height:10px;border-radius:50%;background:#1e3a5f;flex-shrink:0;"></div>
                                    <span style="font-weight:700;color:#1e3a5f;">{{ trip.destination }}</span>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}