{% extends 'base.html.twig' %}

{% block title %}Connexion - ShareTrips{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                {% if error %}
                    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">

                        <h1 class="h3 fw-bold text-center mb-4">Se connecter</h1>

                        <form action="{{ path('app_login') }}" method="post">
                            <div class="form-floating mb-3">
                                <input type="email" class="form-control" id="floatingInput" name="_username"
                                    value="{{ last_username }}" placeholder="name@example.com" required>
                                <label for="floatingInput">Adresse email</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="password" class="form-control" id="floatingPassword" name="_password"
                                    placeholder="Password" required>
                                <label for="floatingPassword">Mot de passe</label>
                            </div>

                            {# If you want to control the URL the user is redirected to on success
                            <input type="hidden" name="_target_path" value="/account"> #}

                            <button type="submit" class="btn btn-primary w-100">Se connecter</button>
                        </form>
        
                    </div>
                </div>

                <p class="text-center mt-3 text-muted small">
                    Pas encore client ?
                    <a href="{{ path('app_register') }}" class="text-decoration-none">Créer un compte</a>
                </p>

            </div>
        </div>
    </div>
{% endblock %}
