{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Share Trips{% endblock %}

{% block body %}
<div class="container" style="max-width:480px;margin:3rem auto;">

    <div class="text-center mb-4">
        <i class="bi bi-lock-fill d-block mb-3" style="font-size:2.5rem;color:#1d4ed8;"></i>
        <h1 style="font-size:1.5rem;font-weight:800;color:#1e3a5f;margin:0 0 .5rem;">
            Mot de passe oublié ?
        </h1>
        <p style="font-size:.9rem;color:#94a3b8;margin:0;">
            Saisissez votre adresse e-mail et nous vous enverrons un lien de réinitialisation.
        </p>
    </div>

    <div class="edit-card">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="mb-4">
                <label class="edit-label">
                    <i class="bi bi-envelope me-1"></i>Adresse e-mail
                </label>
                {{ form_widget(form.email, {
                    'attr': {
                        'class': 'edit-input' ~ (form.email.vars.errors|length ? ' is-invalid' : '')
                    }
                }) }}
                {% if form.email.vars.errors|length %}
                    {% for error in form.email.vars.errors %}
                        <div class="invalid-feedback-st">
                            <i class="bi bi-exclamation-circle-fill"></i> {{ error.message }}
                        </div>
                    {% endfor %}
                {% endif %}
            </div>

            <button type="submit" class="btn-save w-100">
                <i class="bi bi-send me-2"></i>Envoyer le lien
            </button>

        {{ form_end(form) }}

        <div class="text-center mt-3">
            <a href="{{ path('app_login') }}"
               style="font-size:.875rem;color:#94a3b8;text-decoration:none;">
                <i class="bi bi-arrow-left me-1"></i>Retour à la connexion
            </a>
        </div>
    </div>

</div>
{% endblock %}