{% extends 'base.html.twig' %}

{% block title %}Vérifiez vos emails - Share Trips{% endblock %}

{% block body %}
<div class="container" style="max-width:480px;margin:3rem auto;">

    <div class="edit-card text-center">
        <i class="bi bi-envelope-check-fill d-block mb-3" style="font-size:3rem;color:#1d4ed8;"></i>
        <h1 style="font-size:1.4rem;font-weight:800;color:#1e3a5f;margin:0 0 .75rem;">
            E-mail envoyé !
        </h1>
        <p style="font-size:.9rem;color:#64748b;margin:0 0 1.25rem;">
            Si cette adresse est associée à un compte, vous recevrez un lien valable
            <strong>1 heure</strong> pour réinitialiser votre mot de passe.
        </p>

        <div style="background:#f8fafc;border-radius:12px;padding:1rem;margin-bottom:1.5rem;
                    font-size:.8rem;color:#94a3b8;text-align:left;">
            <i class="bi bi-info-circle me-2"></i>
            Vous ne recevez pas l'e-mail ? Vérifiez votre dossier spam ou
            <a href="{{ path('app_forgot_password') }}"
               style="color:#1d4ed8;text-decoration:none;font-weight:600;">
                faites une nouvelle demande
            </a>.
        </div>

        <a href="{{ path('app_login') }}" class="btn-save" style="display:inline-flex;">
            <i class="bi bi-arrow-left me-2"></i>Retour à la connexion
        </a>
    </div>

</div>
{% endblock %}