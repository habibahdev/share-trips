{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h1 class="h3 fw-bold text-center mb-4">Créer un compte</h1>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                        <div class="mb-3">
                            <label class="form-label fw-medium">{{ form_label(form.email) }}</label>
                            {{ form_widget(form.email, {'attr': {'class': 'form-control' ~ (form.email.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.email) }}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">{{ form_label(form.plainPassword.first) }}</label>
                            {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control' ~ (form.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">{{ form_label(form.plainPassword.second) }}</label>
                            {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control' ~ (form.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.plainPassword) }}
                        </div>

                        <button type="submit" class="btn btn-primary w-100">S'inscrire</button>

                    {{ form_end(form) }}

                </div>
            </div>

            <p class="text-center mt-3 text-muted small">
                Vous avez déjà un compte ?
                <a href="{{ path('app_login') }}" class="text-decoration-none">Se connecter</a>
            </p>

        </div>
    </div>
</div>
{% endblock %}