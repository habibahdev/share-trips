{% extends 'base.html.twig' %}

{% block title %}S'inscrire - Share Trips{% endblock %}

{% block body %}
<div class="register-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">

                <div class="text-center mb-4">
                    <a href="{{ path('app_home') }}" class="register-brand">
                        Share<span>Trips</span>
                    </a>
                    <p class="text-muted mt-2 mb-0" style="font-size:.9rem;">
                        Rejoignez la communauté 🚗
                    </p>
                </div>

                <div class="register-card">

                    <h1 style="font-size:1.4rem;font-weight:800;color:#1e3a5f;margin-bottom:1.5rem;">
                        Créer un compte
                    </h1>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'style': 'font-family: Plus Jakarta Sans, sans-serif;'}}) }}

                        <div class="mb-3">
                            <label class="register-label">
                                <i class="bi bi-envelope me-1"></i>Adresse email
                            </label>
                            {{ form_widget(form.email, {
                                'attr': {
                                    'class': 'register-input' ~ (form.email.vars.errors|length ? ' is-invalid' : '')
                                }
                            }) }}
                            {% for error in form.email.vars.errors %}
                                <div class="invalid-feedback-st">
                                    <i class="bi bi-exclamation-circle-fill"></i> {{ error.message }}
                                </div>
                            {% endfor %}
                        </div>

                        <div class="mb-3">
                            <label class="register-label">
                                <i class="bi bi-lock me-1"></i>Mot de passe
                            </label>
                            {{ form_widget(form.plainPassword.first, {
                                'attr': {
                                    'class': 'register-input' ~ (form.plainPassword.first.vars.errors|length ? ' is-invalid' : ''),
                                    'id': 'register_password',
                                    'placeholder': '••••••••'
                                }
                            }) }}
                            {% for error in form.plainPassword.first.vars.errors %}
                                <div class="invalid-feedback-st">
                                    <i class="bi bi-exclamation-circle-fill"></i> {{ error.message }}
                                </div>
                            {% endfor %}
                            <div class="password-hint">
                                <i class="bi bi-info-circle"></i> 8 caractères minimum, majuscule, chiffre
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="register-label">
                                <i class="bi bi-lock-fill me-1"></i>Confirmer le mot de passe
                            </label>
                            {{ form_widget(form.plainPassword.second, {
                                'attr': {
                                    'class': 'register-input' ~ (form.plainPassword.second.vars.errors|length ? ' is-invalid' : ''),
                                    'placeholder': '••••••••'
                                }
                            }) }}
                            {% for error in form.plainPassword.second.vars.errors %}
                                <div class="invalid-feedback-st">
                                    <i class="bi bi-exclamation-circle-fill"></i> {{ error.message }}
                                </div>
                            {% endfor %}
                        </div>

                        <div id="register_password_strength" class="mb-4" style="display:none;">
                            <div style="display:flex;gap:4px;margin-bottom:.35rem;">
                                <div class="s-bar" id="r_s1"></div>
                                <div class="s-bar" id="r_s2"></div>
                                <div class="s-bar" id="r_s3"></div>
                                <div class="s-bar" id="r_s4"></div>
                            </div>
                            <div id="r_s_label" style="font-size:.75rem;color:#94a3b8;"></div>
                        </div>

                        <button type="submit" class="btn-register w-100">
                            Créer mon compte
                        </button>

                    {{ form_end(form) }}

                    <div class="divider-or">ou</div>

                    <a href="{{ path('app_login') }}"
                       style="display:block;text-align:center;background:#eff6ff;color:#1e3a5f;border:none;border-radius:14px;padding:.9rem;font-size:.95rem;font-weight:700;text-decoration:none;transition:background .2s;font-family:'Plus Jakarta Sans',sans-serif;"
                       onmouseover="this.style.background='#dbeafe'"
                       onmouseout="this.style.background='#eff6ff'">
                        J'ai déjà un compte
                    </a>

                </div>

                <p class="text-center mt-4" style="font-size:.8rem;color:#94a3b8;">
                    En créant un compte, vous acceptez nos
                    <a href="#" style="color:#1d4ed8;text-decoration:none;">conditions d'utilisation</a>
                </p>

            </div>
        </div>
    </div>
</div>

<style>
.s-bar { flex:1; height:4px; border-radius:2px; background:#e2e8f0; transition:background .2s; }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('register_plainPassword_first');
    const wrap  = document.getElementById('register_password_strength');
    const lbl   = document.getElementById('r_s_label');
    const bars  = ['r_s1','r_s2','r_s3','r_s4'].map(id => document.getElementById(id));
    const lvl   = [
        {c:'#ef4444', t:'Très faible'},
        {c:'#f97316', t:'Faible'},
        {c:'#eab308', t:'Moyen'},
        {c:'#22c55e', t:'Fort'},
    ];

    if (!input) return;

    input.addEventListener('input', () => {
        const v = input.value;
        if (!v) { wrap.style.display = 'none'; return; }
        let s = 0;
        if (v.length >= 8) s++;
        if (/[A-Z]/.test(v)) s++;
        if (/[0-9]/.test(v)) s++;
        if (/[^A-Za-z0-9]/.test(v)) s++;
        wrap.style.display = 'block';
        bars.forEach((b, i) => { b.style.background = i < s ? lvl[s-1].c : '#e2e8f0'; });
        lbl.textContent = lvl[s-1]?.t ?? '';
        lbl.style.color = lvl[s-1]?.c ?? '#94a3b8';
    });
});
</script>
{% endblock %}