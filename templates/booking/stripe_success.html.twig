{% extends 'base.html.twig' %}

{% block title %}Paiement en cours… - Share Trips{% endblock %}

{% block body %}
    <div style="font-family:'Plus Jakarta Sans',sans-serif;background:#f8fafc;min-height:calc(100vh - 70px);padding:2.5rem 0;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-5">
                    <div style="background:#fff;border-radius:20px;border:1.5px solid #f1f5f9;box-shadow:0 8px 24px rgba(30,58,95,.06);padding:2.5rem 2rem;text-align:center;">

                        {% set payment = booking.payment %}
                        {% set trip    = booking.trip %}

                        {% if payment and payment.status.value == 'completed' %}

                            {# --- Paiement confirmé par le webhook --- #}
                            <div style="width:72px;height:72px;border-radius:50%;background:#dcfce7;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;font-size:1.8rem;">
                                <i class="bi bi-check2-circle" style="color:#166534;"></i>
                            </div>
                            <h1 style="font-size:1.4rem;font-weight:800;color:#1e3a5f;margin-bottom:.5rem;">
                                Paiement confirmé !
                            </h1>
                            <p style="color:#94a3b8;font-size:.9rem;margin-bottom:2rem;">
                                Votre paiement a bien été reçu. Le conducteur va confirmer votre place.
                            </p>

                        {% else %}

                            {# --- En attente du webhook Stripe --- #}
                            <div style="width:72px;height:72px;border-radius:50%;background:#eff6ff;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;">
                                <div style="width:36px;height:36px;border:3px solid #635BFF;border-top-color:transparent;border-radius:50%;animation:spin 1s linear infinite;"></div>
                            </div>
                            <h1 style="font-size:1.4rem;font-weight:800;color:#1e3a5f;margin-bottom:.5rem;">
                                Finalisation du paiement…
                            </h1>
                            <p style="color:#94a3b8;font-size:.9rem;margin-bottom:2rem;">
                                Nous confirmons votre paiement avec Stripe, cela prend quelques secondes.
                            </p>

                        {% endif %}

                        {# Récapitulatif — affiché dans les deux cas #}
                        <div style="background:#eff6ff;border-radius:12px;padding:1.25rem;margin-bottom:2rem;text-align:left;">
                            <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#94a3b8;margin-bottom:.75rem;">
                                Détails du trajet
                            </div>
                            <div style="display:flex;justify-content:space-between;font-size:.875rem;margin-bottom:.5rem;">
                                <span style="color:#94a3b8;">Trajet</span>
                                <span style="color:#1e3a5f;font-weight:600;">
                                    {{ trip.origin }} → {{ trip.destination }}
                                </span>
                            </div>
                            <div style="display:flex;justify-content:space-between;font-size:.875rem;margin-bottom:.5rem;">
                                <span style="color:#94a3b8;">Date</span>
                                <span style="color:#1e3a5f;font-weight:600;">
                                    {{ trip.departureAt|date('d/m/Y à H:i') }}
                                </span>
                            </div>
                            <div style="display:flex;justify-content:space-between;font-size:.875rem;margin-bottom:.5rem;">
                                <span style="color:#94a3b8;">Conducteur</span>
                                <span style="color:#1e3a5f;font-weight:600;">
                                    {{ trip.driver.firstName }} {{ trip.driver.lastName }}
                                </span>
                            </div>
                            {% if payment %}
                            <div style="display:flex;justify-content:space-between;font-size:.875rem;border-top:1.5px solid #dbeafe;padding-top:.5rem;margin-top:.5rem;">
                                <span style="color:#1e3a5f;font-weight:700;">Montant payé</span>
                                <span style="color:#635BFF;font-weight:800;">{{ payment.amount }}€</span>
                            </div>
                            {% endif %}
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <a href="{{ path('app_profile_booking') }}"
                            style="display:block;background:#1e3a5f;color:#fff;border-radius:12px;padding:.85rem;font-size:.9rem;font-weight:700;text-decoration:none;">
                                <i class="bi bi-ticket-perforated me-2"></i> Voir mes réservations
                            </a>
                            <a href="{{ path('app_trips') }}"
                            style="display:block;background:#f8fafc;color:#475569;border:1.5px solid #f1f5f9;border-radius:12px;padding:.85rem;font-size:.9rem;font-weight:600;text-decoration:none;">
                                <i class="bi bi-search me-2"></i> Rechercher d'autres trajets
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
    @keyframes spin { to { transform: rotate(360deg); } }
    </style>

    {# Auto-refresh tant que le paiement n'est pas confirmé #}
    {% if not payment or payment.status.value != 'completed' %}
    <script>
        // Polling toutes les 3 secondes — on recharge la page jusqu'à confirmation du webhook
        setTimeout(() => window.location.reload(), 3000);
    </script>
    {% endif %}

{% endblock %}