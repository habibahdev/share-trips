<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}ShareTrips{% endblock %}</title>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100 bg-light">

        {% include "base/navbar.html.twig" %}

        {% if app.user and app.user.isVerified == false %}
            <div class="alert alert-info d-flex align-items-center custom-alert" role="alert">
                Adresse e-mail non vérifiée <a href="{{ path('app_resend') }}" class="alert-link">Renvoyer le lien</a>.
            </div>
        {% endif %}
        

        <div class="container mt-2">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show d-flex align-items-center custom-alert" role="alert">
                        <span class="alert-icon me-2">
                            {% if label == 'success' %}
                                <i class="bi bi-check-circle-fill"></i>
                            {% elseif label == 'danger' %}
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            {% elseif label == 'warning' %}
                                <i class="bi bi-exclamation-circle-fill"></i>
                            {% else %}
                                <i class="bi bi-info-circle-fill"></i>
                            {% endif %}
                        </span>
                        <div class="flex-grow-1">
                            {{ message }}
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <main class="flex-grow-1">
            <div class="container">
                {% block body %}{% endblock %}
            </div>
        </main>

        {% include "base/footer.html.twig" %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </body>
</html>
