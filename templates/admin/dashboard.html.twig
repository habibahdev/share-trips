{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block main %}
<div class="admin-dashboard">

    <div class="row g-4 mb-4">
        {% set stats = [
            {'title':'Utilisateurs', 'value': totalUsers, 'sub': bannedUsers ~ ' bannis · ' ~ suspendedUsers ~ ' suspendus', 'alert': bannedUsers + suspendedUsers > 0},
            {'title':'Trajets', 'value': totalTrips, 'sub':'', 'alert': false},
            {'title':'Réservations', 'value': totalBookings, 'sub':'', 'alert': false},
            {'title':'Signalements en attente', 'value': pendingReports, 'sub':'', 'alert': pendingReports > 0},
            {'title':'Reviews', 'value': totalReviews, 'sub':'', 'alert': false}
        ] %}

        {% for stat in stats %}
        <div class="col-md-3">
            <div class="profile-card p-4" style="
                background: {{ stat.alert ? '#fef9c3' : '#fff' }};
                border-color: {{ stat.alert ? '#fde68a' : '#f1f5f9' }};
                text-align:center;">
                <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;color:#94a3b8;margin-bottom:.5rem;">{{ stat.title }}</div>
                <div style="font-size:2rem;font-weight:800;color:#1e3a5f;">{{ stat.value }}</div>
                {% if stat.sub %}
                    <div style="font-size:.78rem;color:#dc2626;margin-top:.25rem;">{{ stat.sub }}</div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="profile-card p-4">
        <h2 class="section-title">Signalements récents</h2>

        {% if recentReports is empty %}
            <p class="info-value empty">Aucun signalement en attente.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-sm align-middle" style="margin-bottom:0;">
                    <thead>
                        <tr>
                            <th style="font-size:.72rem;color:#94a3b8;font-weight:700;text-transform:uppercase;">Signalé par</th>
                            <th style="font-size:.72rem;color:#94a3b8;font-weight:700;text-transform:uppercase;">Utilisateur signalé</th>
                            <th style="font-size:.72rem;color:#94a3b8;font-weight:700;text-transform:uppercase;">Motif</th>
                            <th style="font-size:.72rem;color:#94a3b8;font-weight:700;text-transform:uppercase;">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for report in recentReports %}
                        <tr style="transition:background .15s;">
                            <td class="info-value">{{ report.reporter.firstName }} {{ report.reporter.lastName }}</td>
                            <td class="info-value" style="font-weight:600;color:#1e3a5f;">{{ report.reported.firstName }} {{ report.reported.lastName }}</td>
                            <td class="info-value" style="color:#475569;">{{ report.reason|slice(0, 60) }}{% if report.reason|length > 60 %}...{% endif %}</td>
                            <td class="info-value" style="font-size:.78rem;color:#94a3b8;">{{ report.createdAt|date('d/m/Y') }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}