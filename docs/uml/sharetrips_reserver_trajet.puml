@startuml
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #3B6FC2
  FontColor #1A1A2E
}

left to right direction
actor Utilisateur

rectangle "ShareTrips" {
  usecase "Réserver un trajet" as UC1
  usecase "Rechercher un trajet" as UC2
  usecase "Vérifier la disponibilité" as UC3
  usecase "Gérer les trajets complets" as UC4
}

Utilisateur --> UC1
UC1 --> UC2 : <<include>>
UC1 --> UC3 : <<include>>
UC4 ..> UC1 : <<extend>>

@enduml