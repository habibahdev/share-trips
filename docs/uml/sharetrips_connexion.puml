@startuml
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #3B6FC2
  FontColor #1A1A2E
}

left to right direction

actor Visiteur

rectangle "Connexion" {
  usecase "Se connecter" as UC1
  usecase "Vérifier les identifiants" as UC2
  usecase "Gérer les erreurs de connexion" as UC3
}

Visiteur --> UC1
UC1 --> UC2 : <<include>>
UC3 ..> UC1 : <<extend>>
@enduml