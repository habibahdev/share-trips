@startuml
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #3B6FC2
  FontColor #1A1A2E
}

left to right direction

actor Utilisateur

rectangle "ShareTrips" {
  usecase "Créer un trajet" as UC1
  usecase "Vérifier les données du trajet" as UC2
