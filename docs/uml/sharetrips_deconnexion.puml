@startuml
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #3B6FC2
  FontColor #1A1A2E
}

left to right direction

actor Utilisateur
actor Visiteur

rectangle "Déconnexion" {
  Utilisateur -- (Se déconnecter)
  (Se déconnecter) .> (Connexion) : include
  Visiteur -- (Connexion)
}

@enduml